module backward_values {
  @input = external i16 = 27
  function i16 @main() {
    block 0:
      %0 = load volatile i16, fat(global @input, global)
      %1 = ne i16 %0, 0
      br %1, label 3, label 2
    block 1:
      ret %2
    block 2:
      ret 0
    block 3:
      %2 = add i16 %0, 1
      %3 = ugt i16 %0, 5
      br %3, label 1, label 2
  }
}
