-/* Return a number from an octal string */
-static uint32_t b8get(char *ptr, unsigned int n)
-{
-	uint32_t ret = 0;
-	while (*ptr && n) {
-		ret *= 8;
-		ret += (*ptr++) - '0';
-		n--;
-	}
-	return ret;
-}
-
-/* Put a number in octal to string */
-static void b8put(uint32_t x, char *ptr)
-{
-	int digit;
-
-	*--ptr = 0;
-	while (x) {
-		digit = x & 7;
-		x /= 8;
-		*--ptr = '0' + digit;
-	}
-}
