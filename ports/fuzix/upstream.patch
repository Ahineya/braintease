+/* Bounded token input, independent of libc scanf. */
+static int token(FILE *f, char *out) {
+    int c, n = 0;
+    do { c = getc(f); } while (c != EOF && isspace(c));
+    if (c == EOF) {
+        if (ferror(f)) error("read error", empty);
+        return 0;
+    }
+    do {
+        if (n == 50) error("item longer than 50 characters", empty);
+        out[n++] = c;
+        c = getc(f);
+    } while (c != EOF && !isspace(c));
+    out[n] = 0;
+    return 1;
+}
+static int read_pair(FILE *f, char *a, char *b) {
+    if (!token(f, a)) return EOF;
+    return token(f, b) ? 2 : 1;
+}
