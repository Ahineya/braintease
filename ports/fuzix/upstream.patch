-/* Calculate sum of header */
-static uint32_t cksum_calc(void)
-{
-	uint32_t acc = 0;
-	unsigned char *ptr = (unsigned char *) h.name;
-	while (ptr != (unsigned char *) h.cksum)
-		acc += *ptr++;
-	acc += 32 * 8;
-	ptr = (unsigned char *)&(h.type);
-	while (ptr != (unsigned char *) h.pad)
-		acc += *ptr++;
-	return acc;
-}
