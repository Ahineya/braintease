+static uint32_t octal(const char *p, unsigned n) {
+    uint32_t value = 0;
+    while (n && *p == ' ') { p++; n--; }
+    while (n && *p >= '0' && *p <= '7') {
+        unsigned digit = *p++ - '0';
+        if (value > (0xffffffffUL-digit)/8)
+            fatal("numeric field too large");
+        value = value*8+digit;
+        n--;
+    }
+    while (n--) {
+        if (*p && *p != ' ')
+            fatal("invalid octal header field");
+        p++;
+    }
+    return value;
