+    for (;;) {
+        if (suffix) {
+            fd_set ready;
+            struct timeval delay;
+            int n;
+            FD_ZERO(&ready);
+            FD_SET(0, &ready);
+            delay.tv_sec = 0;
+            delay.tv_usec = 50000;
