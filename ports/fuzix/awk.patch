+/* Validate field widths before native 16-bit conversions or allocation. */
+static int format_extent(const char *text)
+{
+    int extent = 0, value;
+    while (*text) {
+        if (!isdigit((unsigned char)*text)) { text++; continue; }
+        value = 0;
+        do {
+            if (value > 1600 || (value == 1600 && *text != '0'))
+                FATAL("format width/precision exceeds 16000 characters");
+            value = value * 10 + *text++ - '0';
+        } while (isdigit((unsigned char)*text));
+        if (value > extent) extent = value;
+    }
+    return extent;
+}
