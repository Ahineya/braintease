+void G_ReadDemoTiccmd (ticcmd_t* cmd)
+{
+    uint32_t cursor = (uint32_t) (demo_p - demobuffer);
+    int result = Doom_DemoDecodeTic(demobuffer,
+                                    (uint32_t) (demoend - demobuffer),
+                                    &cursor, longtics, cmd);
+    if (result == DOOM_DEMO_END)
+    {
+        G_CheckDemoStatus();
+        return;
+    }
+    if (result != DOOM_DEMO_TIC)
+        I_Error("Truncated demo command at octet %lu", (unsigned long) cursor);
+    demo_p = demobuffer + cursor;
+}
 
