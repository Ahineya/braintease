{Module App/Main
  {Import Core/Main open}
  {Import Core/Lift}
  {Import Core/Effect}

  {Program
    {App
      {State {Display HTML}}

      {UI Div(
        :class "min-h-screen bg-zinc-800 text-white p-8"
        {Project ToggleButtons}
        {Project UiDemoCard}
      )}
    }

    {Effects {Pending} {Inbox}}
  }

  {Rules
    {R Toggle/ToSyma
      {Apply Toggle State(.. {Display HTML} ..)}
      State(.. {Display SYMA} ..)
    }

    {R Toggle/ToHTML
      {Apply Toggle State(.. {Display SYMA} ..)}
      State(.. {Display HTML} ..)
    }

    {R ToggleButtons
      {:project ToggleButtons}
      Div(:class "flex gap-3 mb-6 bg-white p-1.5 rounded-xl shadow-lg inline-flex"
        Button(:key left :class {If {Eq d_ HTML} "bg-gradient-to-r from-purple-500 to-blue-500 text-white font-semibold shadow-lg py-2.5 px-6 rounded-lg transition-all duration-200" "bg-transparent text-gray-600 hover:bg-gray-50 font-medium py-2.5 px-6 rounded-lg transition-all duration-200"} "HTML" :onClick Toggle)
        Button(:key right :class {If {Eq d_ SYMA} "bg-gradient-to-r from-purple-500 to-blue-500 text-white font-semibold shadow-lg py-2.5 px-6 rounded-lg transition-all duration-200" "bg-transparent text-gray-600 hover:bg-gray-50 font-medium py-2.5 px-6 rounded-lg transition-all duration-200"} "SYMA" :onClick Toggle)
      )
      :with {Program .. {App .. {State {Display d_}} ..} ..}
    }

    {R UiDemoCard
      {:project UiDemoCard}
      {If {Eq d_ HTML} {CodeDisplay} {Tokenize {UI {CodeDisplay}}}}
      :with {Program .. {App .. {State {Display d_}} ..} ..}
    }

    {R CodeDisplay
      {CodeDisplay}
      Div(
        Div(:class "max-w-md w-full bg-white rounded-2xl shadow-2xl overflow-hidden"
          Div(:class "bg-gradient-to-r from-purple-500 to-blue-500 p-6"
            Div(:class "text-white text-2xl font-bold" "Featured Card")
            Div(:class "text-purple-100 text-sm mt-1" "Beautifully designed with Tailwind")
          )
          Div(:class "p-6"
            Div(:class "text-gray-700 text-base leading-relaxed mb-4"
              "This is a modern card component with a gradient header, smooth hover effects, and clean typography. Perfect for showcasing important content!"
            )
            Div(:class "flex gap-3"
              Div(:class "flex-1 bg-purple-50 rounded-lg p-4 text-center"
                Div(:class "text-purple-600 font-bold text-2xl" "42")
                Div(:class "text-gray-600 text-xs mt-1" "Projects")
              )
              Div(:class "flex-1 bg-blue-50 rounded-lg p-4 text-center"
                Div(:class "text-blue-600 font-bold text-2xl" "1.2K")
                Div(:class "text-gray-600 text-xs mt-1" "Users")
              )
            )
            Div(:class "mt-6"
              Button(:class "w-full bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white font-semibold py-3 px-6 rounded-lg shadow-lg hover:shadow-xl transition-all duration-200"
                "Get Started"
              )
            )
          )
        )
      )
      :innermost
    }

    {R Tokenize
      {.. {.. thing_ ..} ..}
      {.. [ .. thing_ .. ] ..}
      :scope Tokenize
      :innermost
    }

    {R Push
      {Push indent_}
      {Splat :style Concat("margin-left: ", Mul(indent_, 20), "px;")}
      :innermost
    }

    {R Tokenize
      {Tokenize UI(..)}
      {Tokenizing {Indent 0} {Tokens} {Things ..}}
      :innermost
    }

    {R Tokenize
      {Tokenizing {Indent indent_} {Tokens ..} {Things thing_ ..}}
      {Tokenizing {Indent Add(indent_ 1)} {Tokens .. {Div Push(indent_) :class "text-yellow-500" "{"}} {Things ..}}
      :guard Is(thing_ [)
    }

    {R Tokenize
      {Tokenizing {Indent indent_} {Tokens ..} {Things thing_ ..}}
      {Tokenizing {Indent Sub(indent_ 1)} {Tokens .. {Div Push(Sub(indent_ 1)) :class "text-yellow-500" "}"}} {Things ..}}
      :guard Is(thing_ ])
    }

    {R Tokenize
      {Tokenizing {Indent indent_} {Tokens ..} {Things thing_ ..}}
      {Tokenizing {Indent indent_} {Tokens .. {Div Push(indent_) :class "text-yellow-600" Concat("\"", thing_,  "\"")}} {Things ..}}
      :guard IsStr(thing_)
    }

    {R Tokenize
      {Tokenizing {Indent indent_} {Tokens ..} {Things thing_ ..}}
      {Tokenizing {Indent indent_} {Tokens .. {Div Push(indent_) :class "text-green-500" thing_}} {Things ..}}
      :guard IsNum(thing_)
    }

    {R Tokenize
      {Tokenizing {Indent indent_} {Tokens ..} {Things thing_ ..}}
      {Tokenizing {Indent indent_} {Tokens .. {Div Push(indent_) :class "text-cyan-500" Str(thing_)}} {Things ..}}
    }

    {R Tokenize
      {Tokenizing _ {Tokens toks..} _}
      Div(toks..)
    }
  }
}
