      "content": "{Brainfuck \">++++++++[<+++++++++>-]<.>++++[<+++++++>-]<+.+++++++..+++.>>++++++[<+++++++>-]<++.------------.>++++++[<+++++++++>-]<+.<.+++.------.--------.>>>++++[<++++++++>-]<+.\"}",
      "outputs": [
        {
          "type": "result",
          "content": "{End {Output \"Hello, World!\"}}"
        }
