p0_fxe -> p0_nr [label="runs host code",color="#2a805b"];
p0_ir -> p0_wasm [label=""];
p0_wasm -> p0_w [label=""];
p0_w -> p0_we [label="runs",color="#2a805b"];
}
subgraph cluster_view1 {label="02   Execution platforms enable operating systems and applications";
graph [rankdir=LR,bgcolor="white",fontname="Arial",fontsize=18,pad=.18,nodesep=.25,ranksep=.38,splines=polyline]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,margin=".15,.11",fillcolor="#edf3fa",color="#aec4db"]; edge [fontname="Arial",fontsize=11,color="#376a9b",arrowsize=.7,penwidth=1.3];
p1_rv [label="RVM + MMU",fillcolor="#e4f2e9",color="#9bbda8"];
p1_fx [label="Native runtime",fillcolor="#e4f2e9",color="#9bbda8"];
p1_src [label="Shared Riplix sources\nFUZIX-derived + local ports"];
p1_fuz [label="Riplix on Ripple\nBIOS -> FUZIX.SYS -> init / sh",fillcolor="#e4f2e9",color="#9bbda8"];
p1_fuse [label="Fuse-X\nnative hosted Riplix / FXE loader",fillcolor="#e4f2e9",color="#9bbda8"];
p1_ros [label="rOS on RVM\nIO.SYS -> KERNEL.SYS\nCOMMAND.COM + RXE apps",fillcolor="#e4f2e9",color="#9bbda8"];
p1_sdk [label="Shared Unix SDK and APIs\nlibc / files / processes / PTYs\nsockets / select / curses",fillcolor="#eee8f6",color="#b7a7ce"];
p1_tui [label="Terminal applications\nCommander / Rift / Telegram / music\nBourne sh / mux / Unix utilities\nawk / Tcl / BASIC / bf"];
p1_gx [label="GX + /dev/gfx\nNano-X server and clients",fillcolor="#eee8f6",color="#b7a7ce"];
p1_desktop [label="RVM desktop\nNanoWM + NXDSKTOP\nnxterm / clients / FuseDE foundations"];
p1_mac [label="Fuse-X desktop integration\nnative macOS top-level windows\nnxterm / companion clients"];
p1_ns [label="NetSurf graphical browser\nLynx text browser / network tools"];
p1_src -> p1_fuz [label="Ripple build"];
p1_src -> p1_fuse [label="native build"];
p1_rv -> p1_fuz [label="boots",color="#2a805b"];
p1_rv -> p1_ros [label="boots",color="#2a805b"];
p1_fx -> p1_fuse [label="hosts",color="#2a805b"];
p1_fuz -> p1_sdk [label="provides",color="#2a805b"];
p1_fuse -> p1_sdk [label="provides",color="#2a805b"];
