p1_sdk -> p1_ns [label="network / files",color="#2a805b"];
p1_gx -> p1_ns [label="NetSurf GUI",color="#2a805b"];
}
subgraph cluster_view2 {label="03   Guest software and host services meet at explicit boundaries";
graph [rankdir=LR,bgcolor="white",fontname="Arial",fontsize=18,pad=.18,nodesep=.25,ranksep=.38,splines=polyline]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,margin=".15,.11",fillcolor="#edf3fa",color="#aec4db"]; edge [fontname="Arial",fontsize=11,color="#376a9b",arrowsize=.7,penwidth=1.3];
p2_host [label="Host device implementations\nshared from rvm modules\nTTY / display / input / clocks\nNIC / RNG / crypto / audio",fillcolor="#eee8f6",color="#b7a7ce"];
p2_exec [label="Unix execution platforms\nRVM / native runtime",fillcolor="#e4f2e9",color="#9bbda8"];
p2_rbf [label="RBF device host\nfreestanding BF programs\nno PCM or OPL3",fillcolor="#e4f2e9",color="#9bbda8"];
p2_unix [label="Unix guest kernel\nRiplix or native Fuse-X",fillcolor="#e4f2e9",color="#9bbda8"];
p2_net [label="Guest networking\nEthernet -> IPv4 -> UDP / TCP / DNS\nuserspace TLS where required",fillcolor="#eee8f6",color="#b7a7ce"];
p2_apps [label="Lynx / NetSurf / net tools\nTelegram uses guest MTProto\nno host Telegram or TLS proxy"];
p2_pcm [label="/dev/pcm\nC WAV engine -> shared PCM sink",fillcolor="#eee8f6",color="#b7a7ce"];
p2_music [label="RFL music UI + wavplay\n8 / 16 / 24-bit PCM WAV"];
p2_ui [label="C libraries + RFL bindings\ntext / Unicode / INI / themes\nQR / image decoding / curses",fillcolor="#eee8f6",color="#b7a7ce"];
p2_tui [label="Rift / Commander / Telegram\nwrapped text / QR login / 2FA"];
p2_fs [label="C16 V3 filesystem\nRiplix disk image and tools\nFuse-X shared folder adapter",fillcolor="#eee8f6",color="#b7a7ce"];
p2_data [label="Guest applications and tools\nnormal host octets converted\nexplicitly to C16 cells"];
p2_host -> p2_exec [label="reused services",color="#79629e",style=dashed];
p2_host -> p2_rbf [label="supported subset",color="#79629e",style=dashed];
p2_exec -> p2_unix [label="platform services",color="#2a805b"];
p2_unix -> p2_net [label="kernel sockets",color="#2a805b"];
p2_net -> p2_apps [label="protocols stay in guest",color="#2a805b"];
p2_unix -> p2_pcm [label="audio device",color="#2a805b"];
p2_pcm -> p2_music [label="streaming",color="#2a805b"];
p2_unix -> p2_ui [label="libc / curses",color="#2a805b"];
p2_ui -> p2_tui [label="libraries",color="#2a805b"];
p2_unix -> p2_fs [label="storage",color="#2a805b"];
p2_fs -> p2_data [label="files",color="#2a805b"];
}
subgraph cluster_view3 {label="04   Developer tools and experimental paths connect to the same core";
graph [rankdir=LR,bgcolor="white",fontname="Arial",fontsize=18,pad=.18,nodesep=.25,ranksep=.38,splines=polyline]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,margin=".15,.11",fillcolor="#edf3fa",color="#aec4db"]; edge [fontname="Arial",fontsize=11,color="#376a9b",arrowsize=.7,penwidth=1.3];
p3_raw [label="Brainfuck source (.bf)\nmacro source (.bfm) / assembly"];
p3_editor [label="Editor integration\nRFL LSP / IntelliJ\nBF VS Code / TextMate"];
p3_ide [label="Browser IDE + Electron\nReact / TypeScript / Vite / RxJS"];
p3_web [label="Browser tools\nTS assembler + macro workers\nRust rasm / bfm Wasm builds"];
p3_bfe [label="Brainfuck engines\nTS worker interpreter\nRust bf CLI / bf_wasm browser library"];
p3_rbf [label="RBF\nreuses Rust 16-bit BF engine\noptional BF JIT",fillcolor="#e4f2e9",color="#9bbda8"];
p3_driver [label="rcc / rfl / rct / rbt\nscripts / Make / image tooling\ntests / benchmarks / replay"];
p3_core [label="Shared compiler pipelines\nRCC IR / backends / rasm / rlink"];
p3_portable [label="Guest portable C toolchain\nrcc-c -> rcc-ripple\n-> rcc-as -> rcc-ld",style="rounded,filled,dashed",fillcolor="#fff4e3",color="#c99b5e"];
p3_guests [label="Runs in Riplix and Fuse-X\nemits Ripple RXE\nnative FXE generation still host-built",fillcolor="#e4f2e9",color="#9bbda8"];
p3_wasm [label="Generated Wasm apps\nC browser bridge / RFL typed UI\nbatched DOM / timers / fetch"];
p3_ports [label="Exploratory or future work\nRust subset / QuickJS guest engine\nNetSurf JS / Ogg or MP3 / FuseDE shell",style="rounded,filled,dashed",fillcolor="#fff4e3",color="#c99b5e"];
p3_doom [label="Doom + standalone demos\nRVM and native paths\nexperimental BF launcher"];
p3_old [label="Earlier proofs and references\nports/fuzix/native / docs/archive\nsrc/experiments / src/rnd",fillcolor="#f1f1f1",color="#aaa"];
p3_raw -> p3_web [label="assembles / expands"];
p3_raw -> p3_bfe [label="raw .bf",color="#2a805b"];
p3_editor -> p3_core [label="checking / diagnostics",color="#79629e",style=dashed];
p3_ide -> p3_web [label="edits / assembles"];
p3_web -> p3_bfe [label="expands / executes",color="#2a805b"];
p3_bfe -> p3_rbf [label="Rust engine reused",color="#79629e",style=dashed];
p3_driver -> p3_core [label="orchestrates / validates",color="#79629e",style=dashed];
p3_portable -> p3_guests [label="guest tools",color="#2a805b"];
p3_portable -> p3_core [label="RCC IR compatibility",color="#79629e",style=dashed];
p3_core -> p3_wasm [label="Wasm backend"];
p3_core -> p3_doom [label="multiple target builds"];
p3_ports -> p3_core [label="bounded prototypes / future integration",color="#bc842f",style=dashed];
p3_old -> p3_core [label="historical context",color="#79629e",style=dashed];
}
}