digraph RepositoryAtlas {
graph [rankdir=LR,pack=true,packmode="array_u2",bgcolor="white"];
subgraph cluster_view0 {label="01   Languages become executable artifacts";
graph [rankdir=LR,bgcolor="white",fontname="Arial",fontsize=18,pad=.18,nodesep=.25,ranksep=.38,splines=polyline]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,margin=".15,.11",fillcolor="#edf3fa",color="#aec4db"]; edge [fontname="Arial",fontsize=11,color="#376a9b",arrowsize=.7,penwidth=1.3];
p0_c [label="C99 / RCC\nrcpp + rcc-frontend"];
p0_rfl [label="RFL\nparser / checker / lowering"];
p0_pc [label="Portable C\ncproc-derived frontend",style="rounded,filled,dashed",fillcolor="#fff4e3",color="#c99b5e"];
p0_rust [label="Rust prototype\nMIR -> rust-rcc (Ripple / native)",style="rounded,filled,dashed",fillcolor="#fff4e3",color="#c99b5e"];
p0_hand [label="Hand-written Ripple assembly"];
p0_ir [label="RCC IR\ntarget + C16 layout\nrcc-ir / shared linking"];
p0_rip [label="Ripple backend\nrcc-backend + rcc-codegen"];
p0_rl [label="rasm + rlink\n.asm / .pobj / .par"];
p0_image [label="RLINK / SYS1 / RXE1\nRipple machine code"];
p0_cpu [label="CPU template + bf_cpu\nBF export / bfm / compact .bf"];
p0_nat [label="Native backend\nrcc-native / Cranelift"];
p0_fxe [label="Host executable or FXE\nprivate native ABI"];
p0_wasm [label="Wasm backend\nrcc-wasm + runtime"];
p0_w [label="Generated .wasm\nprivate C16 ABI"];
p0_rv [label="RVM",fillcolor="#e4f2e9",color="#9bbda8"];
p0_bf [label="RBF or ordinary BF engine\nordinary engine has no host devices",fillcolor="#e4f2e9",color="#9bbda8"];
p0_nr [label="rcc-native-runtime\nstandalone or Fuse-X host",fillcolor="#e4f2e9",color="#9bbda8"];
p0_we [label="Browser / Node\nWasm engine",fillcolor="#e4f2e9",color="#9bbda8"];
p0_c -> p0_ir [label="emits"];
p0_rfl -> p0_ir [label="emits"];
p0_pc -> p0_ir [label="emits"];
