{
  "arch": "x86",
  "llvm-target": "i686-unknown-none",
  "data-layout": "e-p:32:32-i64:64-i128:128-n16:32:64-S128",
  "target-pointer-width": 32,
  "os": "fuzix",
  "vendor": "unknown",
  "env": "rustcell",
  "panic-strategy": "abort",
  "disable-redzone": true,
  "max-atomic-width": 0,
  "singlethread": true,
  "executables": true
}
