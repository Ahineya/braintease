
}

// MARK: ----------- CODE END ----------













#define FALSE 0
#define TRUE  1

#define ENDL 0xA

#define clear [-]
#define inc(n) {repeat(n, +)}
#define dec(n) {repeat(n, -)}
#define next(n) {repeat(n, >)}
#define prev(n) {repeat(n, <)}
#define nop +-
#define print .

#define set_int_max @clear -


// Aliases for readability
#define right(n) @next(n)
#define left(n) @prev(n)

#define set(n) @clear @inc(n)

// If current cell is non-zero, clear then execute
#define if [ @clear
#define endif ]

// While current cell is non-zero
#define while(code) [code]
#define times(code) [- code]

// Basic loop n times

#define default [@clear]
#define switch(n_branches, default, flag, x) flag @clear+ x {repeat(n_branches, [-)} default
#define case(n, code, flag, x) flag [@clear code] x ]

// ===== DEBUG HELPERS =====

// Create a "breakpoint" (infinite loop)
#define break @clear @inc(1) [$]
#define halt @break

// MARK: ----- Lane Constants

#define STATE_SETUP   3
#define STATE_RUNNING 2
#define STATE_HALT    1

#define BANK_SIZE 64000 // should be 65535, BUT 8*0xffff = A LOT OF CELLS, let's wait for the perf improvement of the tape UI
#define CMD_SIZE 4

#define LANES_COUNT 8

#define L_START 0

#define L_REG 1

#define L_POINTER 2

#define L_CODE 3
#define L_RAM 4

#define L_SCRATCH_A 5
#define L_SCRATCH_B 6

// Shorter aliases
#define L_SA @L_SCRATCH_A
#define L_SB @L_SCRATCH_B
#define L_PTR @L_POINTER
#define L_MEM @L_RAM

// FASTLANE is always the last lane, marking the range between start and instruction pointer

// MARK: ----- Opcode Constants
#define cmd_halt @halt

#define T_OP  0
#define T_VAL 1

#define OP_HALT 0
#define OP_NOP  0x42

#define OP_ADD  0x1
#define OP_SUB  0x2
#define OP_AND  0x3
#define OP_OR   0x4
#define OP_XOR  0x5
#define OP_SL   0x6 // Bit Shift Left
#define OP_SR   0x7 // Bit Shift Right
#define OP_SLT  0x8 // Set Less Than signed
#define OP_SLTU 0x9 // Set Less Than unsigned

#define OP_ADDI 0xA
#define OP_ANDI 0xB
#define OP_ORI  0xC
#define OP_XORI 0xD
#define OP_LI   0xE
#define OP_SLLI 0xF
#define OP_SRLI 0x10

#define OP_LOAD 0x11

#define OP_STOR 0x12

#define OP_JAL  0x13
#define OP_JALR 0x14

#define OP_BEQ  0x15
#define OP_BNE  0x16
#define OP_BLT  0x17
#define OP_BGE  0x18

#define OP_BRK  0x19

#define OP_MUL  0x1A
#define OP_DIV  0x1B
#define OP_MOD  0x1C

#define OP_MULI  0x1D
#define OP_DIVI  0x1E
#define OP_MODI  0x1F
#define OP_LOADC 0x20
#define OP_STORC 0x21
#define OP_IRET  0x22
#define OP_CSRR  0x23
#define OP_CSRW  0x24

// MARK: ----- Register Constants
#define REG_ZONE_W  36
#define REG_ZONE_CW 9

#define R0   0

#define PC   1
#define PCB  2

#define RA   3
#define RAB  4

#define RV0   5
#define RV1   6

#define A0   7
#define A1   8
#define A2   9
#define A3   10

#define X0   11
#define X1   12
#define X2   13
#define X3   14

#define T0   15
#define T1   16
#define T2   17
#define T3   18
#define T4   19
#define T5   20
#define T6   21
#define T7   22

#define S0   23
#define S1   24
#define S2   25
#define S3   26

#define SC   27

#define SB   28
#define SP   29

#define FP   30
#define GP   31

#define R1  #PC
#define R2  #PCB
#define R3  #RA
#define R4  #RAB
#define R5  #RV0
#define R6  #RV1
#define R7  #A0
#define R8  #A1
#define R9  #A2
#define R10 #A3
#define R11 #X0
#define R12 #X1
#define R13 #X2
#define R14 #X3
#define R15 #T0
#define R16 #T1
#define R17 #T2
#define R18 #T3
#define R19 #T4
#define R20 #T5
#define R21 #T6
#define R22 #T7
#define R23 #S0
#define R24 #S1
#define R25 #S2
#define R26 #S3
#define R27 #SC
#define R28 #SB
#define R29 #SP
#define R30 #FP
#define R31 #GP


// MARK: -- Memory mapping
#define OUT      0x00
#define OUT_FLAG 0x01

// MARK: -- Lane Operations

#define nextword @next(#LANES_COUNT)
#define prevword @prev(#LANES_COUNT)
#define lane_start(n) @next(n)
#define lane_end(n) {repeat(n, <)}

#define nextwords(n) {repeat(n, @nextword)}
#define prevwords(n) {repeat(n, @prevword)}

#define lane_reg @lane_start(@L_REG)
#define lane_reg_end @lane_end(@L_REG)

#define lane(lane, code) @lane_start(lane) code @lane_end(lane)

#define fastlane @nextword <
#define fastlane_end > @prevword

#define fl(code) @fastlane code @fastlane_end

#define gtnzll(n) +[@left(n)[@right(n)-]@right(n)[-@left(n)+@right(n)]@left(n)]@left(n)
#define gtnzrl(n) +[@right(n)[@left(n)-]@left(n)[-@right(n)+@left(n)]@right(n)]@right(n)

#define gtzll(n) [@left(n)]
#define gtzrl(n) [@right(n)]

#define goto_nonzero_left_lane @gtnzll(@LANES_COUNT)
#define goto_nonzero_right_lane @gtnzrl(@LANES_COUNT)

#define goto_zero_left_lane @gtzll(@LANES_COUNT)
#define goto_zero_right_lane @gtzrl(@LANES_COUNT)

#define clear_to_zero_left_lane [-@left(@LANES_COUNT)]

// MARK: -- Movement Helpers

#define set_lane(lane, v) @lane(lane, @set(v))

#define instr(instrs) @nextwords(3) instrs @nextwords(5)

#define _instr(value, ftl) + @lane(@L_CODE, @set(value)) @fl(@set(ftl)) @prevword
#define i1(value) @_instr(value, 1)
#define i0(value) @_instr(value, 0)

#define move_to(dest, source) [-dest+source]dest

#define move_l @move_to(@prevword, @nextword)
#define move_r @move_to(@nextword, @prevword)

#define move_l_n(n) @move_to(@prevwords(n), @nextwords(n))
#define move_r_n(n) @move_to(@nextwords(n), @prevwords(n))

#define goto_start_slow @goto_nonzero_left_lane
#define goto_start @fl(@goto_zero_left_lane)

// To make sure it always works: go to start, and then go to IP from the left
#define goto_ip_word @goto_start @nextword @fl(@goto_zero_right_lane)
#define goto_ip_left @fl(@goto_nonzero_left_lane @nextword)

// MARK: -- IP movement and prg flow

#define skip_mmapped @lane(#L_MEM, @nextwords(2))

#define set_noinc_pc_flag {
  @prevword
  @goto_start
  @lane(@L_SA, @set(1))
  @nextword
  @goto_ip_word
}

// Requires to be on IP
#define move_ip_next_command {
  @prevword
  @goto_start
  @lane(@L_SA,
    // A taken branch already positioned the fast lane and PC. Consume its
    // no-increment flag without temporarily decrementing/wrapping PC.
    >+< @times(>-<) >
    @if
      @lane_end(@L_SB)
      @advance_pc_and_ip
      @goto_start @lane_start(@L_SB)
    @endif
    <
  )
  @nextword @goto_ip_word @prevword
}

// RVM permits raw PC >= BANK_SIZE after jumps/branches. An ordinary advance
// resets PC and increments PCB whenever old PC + 1 >= BANK_SIZE. Compare before
// incrementing so PC=65535 also rolls over correctly with 16-bit BF cells.
#define advance_pc_and_ip {
  @goto_PC @lane_reg_end @copy_reg_to_A_via_B
  @prevword @lane(@L_SA, @set(@BANK_SIZE) -) @nextword
  @lane(@L_SA,
    // PC=65535 is unconditionally an overflow. For other values, retain the
    // comparison result in the now-clear state flag while leaving this loop.
    +[
      - @lt
      @move_to(@prevwords(2), @nextwords(2)) @nextwords(2)
    ]
    @prevword @clear @prevword
    @move_to(@nextwords(2), @prevwords(2))
    >+<
    @if
      // PC < BANK_SIZE-1: the next instruction is physically adjacent.
      >-< @lane_end(@L_SA)
      @lane(@L_REG, +)
      @goto_ip_word @fl({repeat(@CMD_SIZE, +@nextword)})
      @prevword @goto_PC @lane_reg_end @lane_start(@L_SA)
    @endif
    >
    @if
      // Re-seek even if the raw PC was already beyond this bank. Advancing
      // only the physical marker would disagree with the register pair.
      @lane_end(@L_SB)
      @lane(@L_REG, @clear @nextword + @prevword)
      @goto_ip_word
      @copy_register_to_ip_B(@goto_PCB, @prevwords(2))
      @_jump_to_bank_addr
      @prevword @goto_PC @lane_reg_end @lane_start(@L_SB)
    @endif
    <
  )
}

// MARK: -- PTR ops

#define goto_ptr_start @lane(@L_POINTER, @goto_zero_left_lane)
#define goto_ptr_end @lane(@L_POINTER, @goto_zero_right_lane)

#define ptr_cleanup {
  @lane(@L_POINTER,
    @goto_zero_right_lane
    @prevword
    [-@prevword]
  )
}

// MARK: -- Registers Movement
// TODO: Make these conform to "all goto ops go to word n lane L_START"
#define goto_PC @goto_start @lane_reg {repeat(@PC, @nextword)} @nextword
#define goto_PCB @goto_start @lane_reg {repeat(@PCB, @nextword)} @nextword

#define _inc_and_copy_pc_ra {
   >+<
   @_copy_pc_ra
   >-<
}

#define _copy_pc_ra {
  @copy_reg_to_A_via_B

  @nextwords(2)
  @lane(@L_REG, @clear)
  @prevwords(2)

  @lane(@L_SA,
    @times(
      @lane_end(@L_SA)
      @nextwords(2)
      @lane_reg
      +
      @lane_reg_end
      @prevwords(2)
      @lane_start(@L_SA)
    )
  )
}

// MARK: -- Scratch ops
#define copy_to_A [->>+>+<<<] >>> [-<<<+>>>] <<<
#define copy_to_B [->>+>+<<<] >> [-<<+>>] <<

#define copy_value_to_A @lane(@L_CODE, @copy_to_A)
#define copy_value_to_B @lane(@L_CODE, @copy_to_B)

#define copy_reg_to_A_via_B @lane(@L_REG, [->>>>+>+<<<<<] >>>>> [-<<<<<+>>>>>] <<<<<)

// MARK: -- Registers fetch
// Carry a whole value through lane zero. The fast-lane sentinel stops the
// leftward walk at word one, so the CPU run-state at word zero is untouched.
// Each hop is a local affine transfer; no value-sized loop contains a scan.
#define carry_start_to_first_word {
  @prevword
  @fl([
    @fastlane_end @nextword @move_l @prevword @fastlane
  ])
  @nextword
}
#define carry_start_to_ip {
  @fl([ @fastlane_end @move_r @fastlane ])
}

// Consume the selector in scratch A, leaving the head on the selected word.
#define mark_register {
  @lane(@L_SA, [-<<<<<+>>>>>])
  [
    @carry_start_to_first_word
    [ - @lane(@L_PTR, +) @move_r ]
  ]
  @goto_marked_register
}

#define goto_marked_register {
  @goto_start @nextword @goto_ptr_end
}

#define move_register_to_ip_sA(n) {
  // Copy REG to START, restoring REG through the adjacent scratch-A cell.
  @lane(@L_REG, [-<+>>>>>+<<<<] >>>> [-<<<<+>>>>] <<<<)
  // Zero sources need no transport. Cleanup accepts either the selected
  // register or the opcode as its starting word.
  [
    @carry_start_to_ip
    [- @prevwords(n) @lane(@L_SA, +) @nextwords(n)]
  ]
}

#define fetch_from_register(n) {
  @prevwords(n) @copy_value_to_A
  @mark_register
  @move_register_to_ip_sA(n)
  @fetch_register_cleanup
}

#define fetch_register_cleanup {
  @prevword @goto_start @nextword @ptr_cleanup
  @nextword @goto_ip_word
}

#define clear_and_mark_destination_register {
  @prevword @copy_value_to_A
  @mark_register
  @lane(@L_REG, @clear)
  @goto_ip_word
}

#define move_result_to_destination_register {
  @lane(@L_SB, [-<<<<<<+>>>>>>])
  // The destination is already clear, so a zero result needs no walk.
  [
    @carry_start_to_first_word
    @lane(@L_PTR, [ @lane_end(@L_PTR) @move_r @lane_start(@L_PTR) ])
    [->+<]
    @goto_ip_word
  ]
}

#define reset_register_mark {
  @prevword @goto_start @nextword @ptr_cleanup
  @nextword @goto_ip_word
}

// MARK: -- math and logic

#define eq(tox, toy) [-toy-tox]+toy[tox-toy[-]] tox
#define not(totemp, tox) - [totemp-tox-] totemp[tox+totemp-] tox
#define neq(tox, toy) @eq(tox, toy) @not(tox, toy)

// Unsigned x < y, consuming both operands and returning the result at x.
// Scratch-A words: [0, y, >x, 0]; the next word's scratch-B marker is cleared.
// The scan increments x before counting down. Guard its wrapping maximum:
// maximum < y is always false, including when y is also maximum. The first
// scratch-A word holds the result only after the scan has finished using it.
#define lt {
  +[
    - @_lt_nonmaximum
    @move_to(@prevwords(2), @nextwords(2)) @nextwords(2)
  ]
  @nextword > @clear < @prevword
  @prevword @clear @prevword
  @move_to(@nextwords(2), @prevwords(2))
}

// x must not be the maximum cell value. A maximum y is safe: its increment
// wraps to zero, and its first decrement restores the full countdown range.
#define _lt_nonmaximum {
  @nextword > + < @prevword
  +@prevword+@nextword

  [-@prevword-[@prevword]@nextword @nextword]

  >[-
       // BLOCK (a>=b)
      < @prevword @set(0) @nextword >
  ]

  @nextword[-
       // BLOCK(a<b)
    < @prevwords(2) - @nextword @set(1) @nextwords(2) >
  ]

  @prevword @clear @prevword < @prevword @clear @nextword


}

// MARK: -- simple_register_op

#define two_registers_op(op) {
    @fetch_from_register(2)
    @fetch_from_register(3)
    op
    @clear_and_mark_destination_register
    @move_result_to_destination_register
    @reset_register_mark
}

#define two_registers_op_no_set(op) {
    @fetch_from_register(2)
    @fetch_from_register(3)
    op
}

#define two_registers_branch_op(op) {
  @fetch_from_register(1)
  @fetch_from_register(2)
  op
}

#define one_register_op(op) {
    @fetch_from_register(2)
    // Load immediate
    @prevwords(3)
    @copy_value_to_A
    @nextwords(3)
    op
    @clear_and_mark_destination_register
    @move_result_to_destination_register
    @reset_register_mark
}

#define ins_li {
    // Preserve the code operand and move its copy directly into the result
    // cell. LI needs no decimal/binary conversion or bitwise operation.
    @prevwords(2)
    @copy_value_to_B
    @lane(@L_SB,
      @move_to(@nextwords(2), @prevwords(2))
    )
    @clear_and_mark_destination_register
    @move_result_to_destination_register
    @reset_register_mark
}

#define no_register_imm2_op(op) {
    // Load immediate
    @prevwords(2)
    @copy_value_to_A
    @nextwords(2)
    @prevwords(3)
    @copy_value_to_A
    @nextwords(3)
    op
}

// MARK: ------------ ALU ops ------------
// Result is stored in sB of the IP word

#define alu_add {
  @prevword @prevword @prevword
  @lane(@L_SA,
    [-@nextword+@prevword]
    @nextword
    @move_to(@nextword @nextword >, < @prevword @prevword)
    <
  )
}

#define alu_sub {
  @prevword @prevword @prevword
  @lane(@L_SA,
    [@nextword-@prevword>+<-]
    >[<+>-]<
    @clear
    @nextword
    @move_r
    @nextword
    @clear
    @prevword
    @move_r
    [->+<]
  )
}

// Local generated ALU routines share the original operand/result convention.
#define alu_mod @prevwords(3) @cpu_alu_mod @nextwords(3)
#define alu_div @prevwords(3) @cpu_alu_div @nextwords(3)

#define alu_mul {
  @prevword @prevword
  @lane(@L_SA,
   [>+<-]
   >
   [
     @prevword < [@nextword+@prevword > + < -]>[<+>-]
     @nextword -
   ]

   < @prevword @clear @nextword

   @move_to(@nextwords(2) >, < @prevwords(2))  <
  )
}

#define alu_and @prevwords(3) @cpu_alu_and @nextwords(3)
#define alu_or  @prevwords(3) @cpu_alu_or @nextwords(3)
#define alu_xor @prevwords(3) @cpu_alu_xor @nextwords(3)
#define alu_sl  @prevwords(3) @cpu_alu_sl @nextwords(3)
#define alu_sr  @prevwords(3) @cpu_alu_sr @nextwords(3)

#define alu_slt {
  // Unsigned comparison is the same as signed minus bias

  @prevwords(1)

  @lane(@L_SA,
    @set(0x8000)
    >
    @set(0x8000)

    [-<@prevword-@nextword>]
    <
    [-@prevwords(2)-@nextwords(2)]

    @prevword

    @lt

    @move_to(@nextwords(2) >, < @prevwords(2)) <
  )
}

#define alu_sltu {
  @lane(@L_SA,
    // // [0, y, >x, [0, 1]]
    @prevword > @set(1) < @prevword

    @lt

    @move_to(@nextwords(2) >, < @prevwords(2)) <
  )

  @lane(@L_SA, [->+<])
}

// MARK: ---------- ALU ops end ----------

// MARK: ---------- Instructions ---------

#define _copy_fastlane_to_ptr {
  @prevword
  @fl(
    [
      @fastlane_end
      @lane(@L_PTR, +)
      @fastlane
      @prevword
    ]
  )

  @nextword
  @goto_ptr_end
}

#define _jump_to_bank_addr {
  // START JTADDR, addr is word[-2] for BANK, word[-3] for ADDR
  // 1. Copy fastlane to PTR. Now fastlane can be freely changed
  @_copy_fastlane_to_ptr

  // Now we want to fill fastlane with REG_ZONE + new PCB * BANK_SIZE * CMD_SIZE + PC
  @prevword
  @fl([-@prevword])

  @fl(@prefill_fastlane(@REG_ZONE_W))

  @nextword
  @goto_ptr_end

  @prevwords(2)
  @lane(@L_SB,
    // Do not multiply PCB*BANK_SIZE*CMD_SIZE in a 16-bit cell: the result
    // can exceed 65535. Nested loops extend the physical fast lane instead.
    @times(
      {repeat(@CMD_SIZE,
        @nextword @set(@BANK_SIZE)
        @times(
          @lane_end(@L_SB) @goto_ptr_start
          @nextword @fl(@goto_zero_right_lane + @goto_zero_left_lane)
          @nextword @goto_ptr_end @prevword @lane_start(@L_SB)
        )
        @prevword
      )}
    )
  )

  @prevword

  @lane(@L_SB,
    @nextwords(2)
      @set(@CMD_SIZE)
    @prevwords(2)

    // So now, @CMD_SIZE * PC + 1 times we need to :
    @nextwords(2)
    @times( // @CMD_SIZE times
      // Copy PC to sA
      @prevwords(2)
      [-<+@nextword+@prevword>]
       <@nextword
      [->@prevword+@nextword<]
      @prevword>

      @times( // PC times
        @lane_end(@L_SB)
        @goto_ptr_start

        @nextword @fl(@goto_zero_right_lane + @goto_zero_left_lane)

        @nextword
        @goto_ptr_end
        @prevwords(3)
        @lane_start(@L_SB)
      )

      <[->+<]>
      @nextwords(2)
    )

    @prevwords(2)
    @clear
    @nextwords(2)
  )

  @goto_ptr_start
  @nextword
  @ptr_cleanup
  @nextword
  @goto_ip_word

  @fl({repeat(4, @set(1) @nextword)})
  @prevword
  @fl(@clear) // We need 0 in the last fastlane pos
}

// Move a branch's fast-lane boundary by a count of instructions carried in
// the pointer lane. Every iteration consumes one instruction and transfers
// the remaining count to the next boundary; all pointer cells end at zero.
// Unlike a full bank seek, only the changed suffix of the fast lane is touched.
#define _branch_forward {
  [
    -
    @next(5) + @nextword + @nextword + @nextword + @nextword @prev(5)
    @prevwords(4) [-@nextwords(4)+@prevwords(4)] @nextwords(4)
  ]
}

#define _branch_backward {
  [
    -
    @next(5) @prevword @clear @prevword @clear @prevword @clear @prevword @clear @prev(5)
    @nextwords(4) [-@prevwords(4)+@nextwords(4)] @prevwords(4)
  ]
}

// A conditional branch preserves PCB, including when its signed displacement
// wraps the raw 16-bit PC or leaves PC >= BANK_SIZE. Compare old/new raw PCs
// to choose physical direction; their unsigned difference is at most 65535.
// Inputs: old PC in word[-4].SA, target PC in word[-3].SB; architectural PC
// is already updated. PCB is unchanged and need not be fetched or copied.
#define _branch_to_same_bank {
  @prevwords(3) @lane_start(@L_SB)
  // Consume target into comparison operand and wrapping delta accumulator.
  [-@prevwords(2)<+>@prevword+@nextwords(3)]
  @prevword <
  // Retain old PC while subtracting it from delta, using word[-3].SA.
  [-@prevwords(2)>-<@nextwords(3)+@prevword]
  @nextword [-@prevword+@nextword] @prevword
  @lt
  >+<
  @if
    >-< @lane_end(@L_SA) @nextwords(4)
    @prevwords(6) @lane_start(@L_SB)
    [-@nextwords(6)<<<<+>>>>@prevwords(6)] @nextwords(6) <<<<
    @_branch_forward
    @lane_end(@L_PTR) @prevwords(4) @lane_start(@L_SA)
  @endif
  >
  @if
    @lane_end(@L_SB) @nextwords(4)
    @prevwords(6) @lane_start(@L_SB)
    [-@nextwords(6)<<<<->>>>@prevwords(6)] @nextwords(6) <<<<
    @_branch_backward
    @lane_end(@L_PTR) @prevwords(4) @lane_start(@L_SB)
  @endif
  < @lane_end(@L_SA) @nextwords(4)
}

// Preserve a register in an unused scratch-B cell at the current instruction.
// goto_reg must finish in L_REG; offs selects a word relative to the opcode.
#define copy_register_to_ip_B(goto_reg, offs) {
  @prevword goto_reg @lane_reg_end
  @copy_reg_to_A_via_B
  @lane(@L_SA,
    @times(
      @lane_end(@L_SA)
      @goto_ip_word offs @lane(@L_SB, +)
      @prevword goto_reg @lane_reg_end @lane_start(@L_SA)
    )
  )
  @goto_ip_word
}

#define link_return_address {
  // Snapshot PCB before writing rd: rd itself may be PCB or RAB.
  // word[-1].SB is used while marking rd; word[-4].SB stays untouched.
  @copy_register_to_ip_B(@goto_PCB, @prevwords(4))
  @copy_register_to_ip_B(@goto_PC, @nop)
  @lane(@L_SB, +)
  @clear_and_mark_destination_register
  @move_result_to_destination_register
  @reset_register_mark

  // The link pair is (rd, RAB), with the saved PCB winning if rd == RAB.
  @prevword @goto_PCB @nextwords(2) @clear @lane_reg_end
  @goto_ip_word @prevwords(4)
  @lane(@L_SB,
    @times(
      @lane_end(@L_SB)
      @goto_PCB @nextwords(2) + @lane_reg_end
      @goto_ip_word @prevwords(4) @lane_start(@L_SB)
    )
  )
  @nextwords(4)
}

#define ins_jal {
  // rd == R0 is a non-linking jump. JALR operands were already fetched, so
  // writing an aliased link destination cannot change the snapshotted target.
  @prevword
  @copy_value_to_A
  @lane(@L_SA,
    @if
      @lane_end(@L_SA) @nextword
      @link_return_address
      @prevword @lane_start(@L_SA)
    @endif
  )
  @nextword
  @prevwords(2)
  @lane(@L_SA, // First op param is BANK
    [->+@nextwords(2)+@prevwords(2)<]@nextwords(2)
  )

  // TODO: Candidate for "set pcb"
  @prevword
  @goto_start
  @goto_PCB @clear
  @lane_reg_end
  @goto_ip_word
  @lane(@L_SB,
    @times(
      @lane_end(@L_SB)
      @prevword
      @goto_start
      @goto_PCB
      +
      @lane_reg_end
      @goto_ip_word
      @lane_start(@L_SB)
    )
  )

  @prevwords(3)
  @lane(@L_SA, // Second op param is ADDR
    [->+@nextwords(3)+@prevwords(3)<]@nextwords(3)
  )

  // TODO: Candidate for "set pc"
  @prevword
  @goto_start
  @nextword

  @goto_PC @clear
  @lane_reg_end

  @goto_ip_word
  @lane(@L_SB,
    @times(
      @lane_end(@L_SB)
      @prevword
      @goto_start
      @nextword @goto_PC
      +
      @lane_reg_end
      @goto_ip_word
      @lane_start(@L_SB)
    )
  )

  // Now bank and addr are in word[-2] and word[-3]

  @set_noinc_pc_flag

  @_jump_to_bank_addr


}

#define ins_beq(should_inverse) @ins_branch(@eq(@nextword, @prevword), should_inverse)
#define signed_lt @dec(0x8000) @prevword @dec(0x8000) @nextword @lt
#define ins_blt(should_inverse) @ins_branch(@signed_lt, should_inverse)

#define ins_branch(cmp, should_inverse) {
  @prevword

  @lane(@L_SA,
    cmp
    {if(should_inverse, @not(>, <), @nop)}
  )
  @lane_start(@L_SA)

  // Early exit
  // Copy comparison result to here[-2]
  [-@prevword+@prevword+@nextwords(2)] @prevwords(2) @move_to(@nextwords(2), @prevwords(2))

  @eq(<, >)  // if zero
  @if
    @lane_end(@L_SA)
    @nextword
  @endif

  @prevword [-@nextword+@prevword] @nextword

  @if
    @lane_end(@L_SA)

    @prevword
    @goto_PC
    @lane_reg_end
    @copy_reg_to_A_via_B

    @lane(@L_SA,
      @times(
        @lane_end(@L_SA)
        @goto_ip_word
        @prevword
        @lane(@L_SA, +)
        @goto_PC
        @lane_reg_end
        @lane_start(@L_SA)
      )
    )
    @goto_ip_word

    @prevwords(3)
    @copy_value_to_B

    @nextwords(2)


    @lane(@L_SA,
      // Preserve old PC for a relative physical branch after PC is updated.
      [-@prevwords(3)+@prevword+@nextwords(4)]
      @prevwords(4) [-@nextwords(4)+@prevwords(4)] @nextwords(4)
      @move_to(@prevwords(2) >, < @nextwords(2)) < // Very important! calculating addr by PC + imm
    )

    // Now we need to copy new calculated addr to PC
    @lane(@L_SB,
      [-@prevword+@prevword+@nextwords(2)] @prevwords(2) @move_to(@nextwords(2), @prevwords(2))
    )

    @goto_PC @clear @lane_reg_end
    @goto_ip_word
    @prevwords(4)

    @lane(@L_SB,
      @times(
        @lane_end(@L_SB)
        @goto_PC + @lane_reg_end
        @goto_ip_word
        @prevwords(4)
        @lane_start(@L_SB)
      )
    )
    @nextwords(4)
    // Copied. Safe to jump!

    @set_noinc_pc_flag

    @_branch_to_same_bank

  @endif
}

// Snapshot address/value before clearing operands or writing a destination.
// The generated RAM walker consumes only temporary START/PTR/scratch lanes.
#define capture_memory_address {
  @cpu_capture_A(@prevwords(2), 65)
  @cpu_capture_A(@prevwords(3), 66)
  @prevwords(2) @lane(@L_SA, @clear)
  @prevword @lane(@L_SA, @clear) @nextwords(3)
}
#define ins_stor {
  @fetch_from_register(1)
  @capture_memory_address
  @cpu_capture_A(@prevword, 61)
  @prevword @lane(@L_SA, @clear) @goto_start
  @cpu_ram_store
  {if(#ENABLE_IRQ, @cpu_irq_store, {repeat(0, +)})}
  @nextword @goto_ip_word
}
#define ins_load {
  @capture_memory_address
  @prevword @goto_start @cpu_ram_load
  // The load leaves its copied value in START at word one.
  @nextword
  [ @carry_start_to_ip [->>>>>>+<<<<<<] ]
  @prevword @goto_start @nextword @goto_ip_word
}

// MARK: --------Instructions end --------

// MARK: -- Fast-lane helpers
#define prefill_fastlane(n) @clear {repeat(n, @nextword +)} @prevwords(n)
#define clear_fastlane(n) @clear {repeat(n, @nextword @clear)} @prevwords(n)

// Copy a scratch-A operand into persistent CPU state without consuming it.
// All captures finish at the current opcode and leave lane zero clear.
#define cpu_capture_A(offs, word) {
  @prevword @goto_start @nextwords(word) @lane(@L_REG, @clear)
  @prevwords(word) @nextword @goto_ip_word
  offs @lane(@L_SA, [-<<<<<+>>>>>>+<] >[-<+>]<)
  [
    @carry_start_to_first_word
    [- @prevword @nextwords(word) @lane(@L_REG, +) @prevwords(word) @nextword]
  ]
  @prevword @goto_start @nextword @goto_ip_word
}
#define cpu_capture_code(offs, back, word) {
  offs @copy_value_to_A back
  @cpu_capture_A(offs, word)
  offs @lane(@L_SA, @clear) back
}
#define cpu_capture_words {
  @cpu_capture_code(@prevword, @nextword, 58)
  @cpu_capture_code(@prevwords(2), @nextwords(2), 59)
  @cpu_capture_code(@prevwords(3), @nextwords(3), 60)
}
// Reuse the existing physical bank seek, leaving all ordinary registers intact.
#define cpu_reseek {
  @prevword @goto_start @nextwords(56) @lane(@L_REG, @clear)
  @prevwords(56) @nextword @goto_ip_word
  @copy_register_to_ip_B(@goto_PCB, @prevwords(2))
  @copy_register_to_ip_B(@goto_PC, @prevwords(3))
  @_jump_to_bank_addr
}
#define cpu_system(handler) {
  @cpu_capture_words
  @prevword @goto_start handler @nextword @goto_ip_word
}
#define ins_iret {
  @prevword @goto_start @cpu_iret @nextword @goto_ip_word
  @cpu_reseek @set_noinc_pc_flag
}
#define loadc @ophandler(@cpu_system(@cpu_loadc))
#define storc @ophandler(@cpu_system(@cpu_storc))
#define csrr @ophandler(@cpu_system(@cpu_csrr))
#define csrw @ophandler(@cpu_system(@cpu_csrw))
#define iret @ophandler(@ins_iret)

// MARK: ------ Opcode Handlers ---------

#define ophandler(handler) @lane_end(#L_SB) handler @lane_start(#L_SB)

#define add  @ophandler(@two_registers_op(@alu_add))
#define sub  @ophandler(@two_registers_op(@alu_sub))
#define mod  @ophandler(@two_registers_op(@alu_mod))
#define mul  @ophandler(@two_registers_op(@alu_mul))
#define div  @ophandler(@two_registers_op(@alu_div))
#define and  @ophandler(@two_registers_op(@alu_and))
#define or   @ophandler(@two_registers_op(@alu_or))
#define xor  @ophandler(@two_registers_op(@alu_xor))
#define sl   @ophandler(@two_registers_op(@alu_sl))
#define sr   @ophandler(@two_registers_op(@alu_sr))
#define slt  @ophandler(@two_registers_op(@alu_slt))
#define sltu @ophandler(@two_registers_op(@alu_sltu))

#define addi @ophandler(@one_register_op(@alu_add))
#define modi  @ophandler(@one_register_op(@alu_mod))
#define divi  @ophandler(@one_register_op(@alu_div))
#define muli  @ophandler(@one_register_op(@alu_mul))
#define andi @ophandler(@one_register_op(@alu_and))
#define ori  @ophandler(@one_register_op(@alu_or))
#define xori @ophandler(@one_register_op(@alu_xor))
#define li   @ophandler(@ins_li)
#define sli  @ophandler(@one_register_op(@alu_sl))
#define sri  @ophandler(@one_register_op(@alu_sr))

// Fetch both address operands before overwriting a possibly aliased destination.
#define load @ophandler(@two_registers_op(@ins_load))
#define stor @ophandler(@two_registers_op_no_set(@ins_stor))

#define jal  @ophandler(@no_register_imm2_op(@ins_jal))
#define jalr @ophandler(@two_registers_op_no_set(@ins_jal))

#define beq  @ophandler(@two_registers_branch_op(@ins_beq(#FALSE))) // beq rs rt imm, jumps to current pcb+pc+imm
#define bne  @ophandler(@two_registers_branch_op(@ins_beq(#TRUE)))
#define blt  @ophandler(@two_registers_branch_op(@ins_blt(#FALSE)))
#define bge  @ophandler(@two_registers_branch_op(@ins_blt(#TRUE)))

#define opnop @ophandler(@nop)

#define opcase(op, han) @case(op,  han, >, <)

#define program_start(w1, w2, w3, w4) {
  {repeat(@REG_ZONE_CW,
    @instr(@i1(#OP_HALT) @i1(0) @i1(0) @i1(0))
  )}

  @instr(@i0(w1) @i1(w2) @i1(w3) @i1(w4))
}

// Instructions preceding a nonzero entry point have a filled fast lane.
#define program_prefix_start(w1, w2, w3, w4) {
  {repeat(@REG_ZONE_CW,
    @instr(@i1(#OP_HALT) @i1(0) @i1(0) @i1(0))
  )}
  @cmd_prefix(w1, w2, w3, w4)
}
#define cmd_prefix(w1, w2, w3, w4) {
  @instr(@i1(w1) @i1(w2) @i1(w3) @i1(w4))
}
#define cmd_entry(w1, w2, w3, w4) {
  @instr(@i0(w1) @i1(w2) @i1(w3) @i1(w4))
}

#define cmd(w1, w2, w3, w4) {
  @instr(@i0(w1) @i0(w2) @i0(w3) @i0(w4))
}

#define program_end {
  @cmd(  #OP_HALT, #OP_HALT, #OP_HALT, #OP_HALT)
}

// MARK: ------------ MAIN ---------------
// Set START marker
@set(#STATE_SETUP)

// MARK: -- Set registers
@nextword
@nextword
#define REG_VALUES {#ENTRY_POINT,#ENTRY_BANK}
@lane(#L_REG,
  {for(v in #REG_VALUES, @set(v) @nextword)}
)

@goto_start_slow

@skip_mmapped

#define prg(data, code) data @goto_start_slow @nextword code
@PROGRAM

@prevword
// Generated images know their extent: stop at word zero instead of wrapping
// around the tape while searching for a zero to the left of the state flag.
{if(#PROGRAM_WORDS, {repeat(#PROGRAM_WORDS, @clear @prevword)}, @clear_to_zero_left_lane @nextword)}
@set(#STATE_RUNNING)
@cpu_boot

// MARK: -- Main loop
@while(
  [->+>+<<]>>[-<<+>>]<< // Copy start flag to >, so switch does not fuck up our start marker
  >
  @switch(2, @default, >, <)
  @case(#STATE_RUNNING, <<@execute>>, >, <)
  @case(#STATE_HALT, @clear <<@clear>>, >, <)
  <
)

// MARK: ---- Executor
#define execute {
  {if(#ENABLE_IRQ,
    @cpu_irq_boundary
    @nextwords(56) @lane(@L_REG,
      @if
        @lane_reg_end @prevwords(56) @nextword @goto_ip_word
        @cpu_reseek
        @prevword @goto_start @nextwords(56) @lane_reg
      @endif
    ) @prevwords(56)
  , {repeat(0, +)})}
  @nextword

  @goto_ip_word #BRK_IF_DEBUG
  @lane(@L_CODE, @copy_to_A)
  @lane(@L_SA,
    @inc(1) // To properly work with switch statement

    // MARK: ------- Opcode Switch
    @switch(38, @default, >, <)
      @opcase(#OP_NOP, @opnop)
      @opcase(#OP_CSRW, {if(#ENABLE_IRQ, @csrw, @ophandler(@prevword @goto_start @cpu_irq_disabled @nextword @goto_ip_word))})
      @opcase(#OP_CSRR, {if(#ENABLE_IRQ, @csrr, @ophandler(@prevword @goto_start @cpu_irq_disabled @nextword @goto_ip_word))})
      @opcase(#OP_IRET, {if(#ENABLE_IRQ, @iret, @ophandler(@prevword @goto_start @cpu_irq_disabled @nextword @goto_ip_word))})
      @opcase(#OP_STORC, @storc)
      @opcase(#OP_LOADC, @loadc)

      @opcase(#OP_MODI,   @modi )
      @opcase(#OP_DIVI,   @divi )
      @opcase(#OP_MULI,   @muli )

      @opcase(#OP_MOD,   @mod )
      @opcase(#OP_DIV,   @div )
      @opcase(#OP_MUL,   @mul )

      @opcase(#OP_BRK,   @HOST_BREAK )

      @opcase(#OP_BGE,   @bge)
      @opcase(#OP_BLT,   @blt)
      @opcase(#OP_BNE,   @bne)
      @opcase(#OP_BEQ,   @beq)

      @opcase(#OP_JALR,  @jalr)
      @opcase(#OP_JAL,   @jal)

      @opcase(#OP_STOR,  @stor)
      @opcase(#OP_LOAD,  @load)

      @opcase(#OP_SRLI,   @sri)
      @opcase(#OP_SLLI,   @sli)
      @opcase(#OP_LI,    @li)
      @opcase(#OP_XORI,  @xori)
      @opcase(#OP_ORI,   @ori)
      @opcase(#OP_ANDI,  @andi)
      @opcase(#OP_ADDI,  @addi)
      @opcase(#OP_SLTU,  @sltu)
      @opcase(#OP_SLT,   @slt)
      @opcase(#OP_SR,    @sr)
      @opcase(#OP_SL,    @sl)
      @opcase(#OP_XOR,   @xor)
      @opcase(#OP_OR,    @or)
      @opcase(#OP_AND,   @and)
      @opcase(#OP_SUB,   @sub)
      @opcase(#OP_ADD,   @add)
      @opcase(#OP_HALT,  @lane_end(#L_SB) @prevword @goto_start @set(#STATE_HALT) @goto_ip_word @lane_start(#L_SB))
  )

  @move_ip_next_command

  @goto_start
  // Every guest instruction preserves the architectural zero register.
  @nextword @lane(@L_REG, @clear) @prevword
  {if(#ENABLE_IRQ, @cpu_timer_tick, {repeat(0, +)})}
}
