static uint8 skipVariableMarker(RiJpegState *state)
{
   uint16 left = getBits1(state, 16);

   if (left < 2)
      return PJPG_BAD_VARIABLE_MARKER;

   left -= 2;

   while (left)
   {
      getBits1(state, 8);
      left--;
   }
   
   return 0;
}
