static uint8 nextMarker(RiJpegState *state)
{
   uint8 c;


   do
   {
      do
      {


         c = (uint8)getBits1(state, 8);

      } while (c != 0xFF);

      do
      {
         c = (uint8)getBits1(state, 8);

      } while (c == 0xFF);

   } while (c == 0);

   // If bytes > 0 here, there where extra bytes before the marker (not good).

   return c;
}
