static uint8 readDQTMarker(RiJpegState *state)
{
   uint16 left = getBits1(state, 16);

   if (left < 2)
      return PJPG_BAD_DQT_MARKER;

   left -= 2;

   while (left)
   {
      uint8 i;
      uint8 n = (uint8)getBits1(state, 8);
      uint8 prec = n >> 4;
      uint16 totalRead;

      n &= 0x0F;

      if (n > 1)
         return PJPG_BAD_DQT_TABLE;

      state->gValidQuantTables |= (n ? 2 : 1);         

      // read quantization entries, in zag order
      for (i = 0; i < 64; i++)
      {
         uint16 temp = getBits1(state, 8);

         if (prec)
            temp = (temp << 8) + getBits1(state, 8);

         if (n)
            state->gQuant1[i] = (int16)temp;            
         else
            state->gQuant0[i] = (int16)temp;            
      }
      
      createWinogradQuant(state, n ? state->gQuant1 : state->gQuant0);

      totalRead = 64 + 1;

      if (prec)
         totalRead += 64;

      if (left < totalRead)
         return PJPG_BAD_DQT_LENGTH;

      left = (uint16)(left - totalRead);
   }
   
   return 0;
}
