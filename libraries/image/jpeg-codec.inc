// Read a start of scan (SOS) marker.
static uint8 readSOSMarker(RiJpegState *state)
{
   uint8 i;
   uint16 left = getBits1(state, 16);
   uint8 spectral_start, spectral_end, successive_high, successive_low;

   state->gCompsInScan = (uint8)getBits1(state, 8);

   left -= 3;

   if ( (left != (state->gCompsInScan + state->gCompsInScan + 3)) || (state->gCompsInScan < 1) || (state->gCompsInScan > PJPG_MAXCOMPSINSCAN) )
      return PJPG_BAD_SOS_LENGTH;
   
   for (i = 0; i < state->gCompsInScan; i++)
   {
      uint8 cc = (uint8)getBits1(state, 8);
      uint8 c = (uint8)getBits1(state, 8);
      uint8 ci;
      
      left -= 2;
     
      for (ci = 0; ci < state->gCompsInFrame; ci++)
         if (cc == state->gCompIdent[ci])
            break;

      if (ci >= state->gCompsInFrame)
         return PJPG_BAD_SOS_COMP_ID;

      state->gCompList[i]    = ci;
      state->gCompDCTab[ci] = (c >> 4) & 15;
      state->gCompACTab[ci] = (c & 15);
   }

   spectral_start  = (uint8)getBits1(state, 8);
   spectral_end    = (uint8)getBits1(state, 8);
   successive_high = (uint8)getBits1(state, 4);
   successive_low  = (uint8)getBits1(state, 4);

   if(spectral_start || spectral_end != 63 || successive_high || successive_low)return PJPG_UNSUPPORTED_MODE;
   left -= 3;

   while (left)                  
   {
      getBits1(state, 8);
      left--;
   }
   
   return 0;
}
