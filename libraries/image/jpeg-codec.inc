   state->gImageYSize = getBits1(state, 16);

   if ((!state->gImageYSize) || (state->gImageYSize > PJPG_MAX_HEIGHT))
      return PJPG_BAD_HEIGHT;

   state->gImageXSize = getBits1(state, 16);

   if ((!state->gImageXSize) || (state->gImageXSize > PJPG_MAX_WIDTH))
      return PJPG_BAD_WIDTH;

   state->gCompsInFrame = (uint8)getBits1(state, 8);

   if (state->gCompsInFrame > 3)
      return PJPG_TOO_MANY_COMPONENTS;

   if (left != (state->gCompsInFrame + state->gCompsInFrame + state->gCompsInFrame + 8))
      return PJPG_BAD_SOF_LENGTH;
   
   for (i = 0; i < state->gCompsInFrame; i++)
   {
      state->gCompIdent[i] = (uint8)getBits1(state, 8);
      state->gCompHSamp[i] = (uint8)getBits1(state, 4);
      state->gCompVSamp[i] = (uint8)getBits1(state, 4);
      state->gCompQuant[i] = (uint8)getBits1(state, 8);
      
      if (state->gCompQuant[i] > 1)
         return PJPG_UNSUPPORTED_QUANT_TABLE;
   }
   
   return 0;
