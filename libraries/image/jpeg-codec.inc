      return 0;

   bytesleft = 4096; //512;

   for ( ; ; )
   {
      if (--bytesleft == 0)
         return PJPG_NOT_JPEG;

      lastchar = thischar;

      thischar = (uint8)getBits1(state, 8);

      if (lastchar == 0xFF) 
      {
         if (thischar == M_SOI)
            break;
         else if (thischar == M_EOI)	//getBits1 will keep returning M_EOI if we read past the end
            return PJPG_NOT_JPEG;
      }
   }

   /* Check the next character after marker: if it's not 0xFF, it can't
   be the start of the next marker, so the file is bad */

   thischar = (uint8)((state->gBitBuf >> 8) & 0xFF);

   if (thischar != 0xFF)
      return PJPG_NOT_JPEG;
      
   return 0;
}
//------------------------------------------------------------------------------
// Find a start of frame (SOF) marker.
static uint8 locateSOFMarker(RiJpegState *state)
{
   uint8 c;

   uint8 status = locateSOIMarker(state);
   if (status)
      return status;
   
   status = processMarkers(state, &c);
   if (status)
      return status;

   switch (c)
   {
      case M_SOF2:
      {
         // Progressive JPEG - not supported by picojpeg (would require too
         // much memory, or too many IDCT's for embedded systems).
         return PJPG_UNSUPPORTED_MODE;
      }
      case M_SOF0:  /* baseline DCT */
      {
         status = readSOFMarker(state);
         if (status)
            return status;
            
         break;
      }
      case M_SOF9:  
      {
         return PJPG_NO_ARITHMITIC_SUPPORT;
      }
      case M_SOF1:  /* extended sequential DCT */
      default:
      {
         return PJPG_UNSUPPORTED_MARKER;
      }
   }
   
   return 0;
}
//------------------------------------------------------------------------------
// Find a start of scan (SOS) marker.
static uint8 locateSOSMarker(RiJpegState *state, uint8* pFoundEOI)
{
   uint8 c;
   uint8 status;

   *pFoundEOI = 0;
      
   status = processMarkers(state, &c);
   if (status)
      return status;

   if (c == M_EOI)
   {
      *pFoundEOI = 1;
      return 0;
   }
   else if (c != M_SOS)
      return PJPG_UNEXPECTED_MARKER;

   return readSOSMarker(state);
}
//------------------------------------------------------------------------------
static uint8 init(RiJpegState *state)
{
   state->gImageXSize = 0;
   state->gImageYSize = 0;
   state->gCompsInFrame = 0;
   state->gRestartInterval = 0;
   state->gCompsInScan = 0;
   state->gValidHuffTables = 0;
   state->gValidQuantTables = 0;
   state->gTemFlag = 0;
   state->gInBufOfs = 0;
   state->gInBufLeft = 0;
   state->gBitBuf = 0;
   state->gBitsLeft = 8;

   getBits1(state, 8);
   getBits1(state, 8);

   return 0;
}
//------------------------------------------------------------------------------
// This method throws back into the stream any bytes that where read
// into the bit buffer during initial marker scanning.
static void fixInBuffer(RiJpegState *state)
{
   /* In case any 0xFF's where pulled into the buffer during marker scanning */

   if (state->gBitsLeft > 0)  
      stuffChar(state, (uint8)(state->gBitBuf & 255));
   
   stuffChar(state, (uint8)(state->gBitBuf >> 8));
   
   state->gBitsLeft = 8;
   getBits2(state, 8);
   getBits2(state, 8);
}
//------------------------------------------------------------------------------
// Restart interval processing.
static uint8 processRestart(RiJpegState *state)
{
   // Let's scan a little bit to find the marker, but not _too_ far.
   // 1536 is a "fudge factor" that determines how much to scan.
   uint16 i;
   uint8 c = 0;

   for (i = 1536; i > 0; i--)
      if (getChar(state) == 0xFF)
         break;

   if (i == 0)
      return PJPG_BAD_RESTART_MARKER;
   
   for ( ; i > 0; i--)
      if ((c = getChar(state)) != 0xFF)
         break;

   if (i == 0)
      return PJPG_BAD_RESTART_MARKER;

   // Is it the expected marker? If not, something bad happened.
   if (c != (state->gNextRestartNum + M_RST0))
      return PJPG_BAD_RESTART_MARKER;

   // Reset each component's DC prediction values.
   state->gLastDC[0] = 0;
   state->gLastDC[1] = 0;
   state->gLastDC[2] = 0;

   state->gRestartsLeft = state->gRestartInterval;

   state->gNextRestartNum = (state->gNextRestartNum + 1) & 7;

   // Get the bit buffer going again

   state->gBitsLeft = 8;
   getBits2(state, 8);
   getBits2(state, 8);
   
   return 0;
}
//------------------------------------------------------------------------------
// FIXME: findEOI(state) is not actually called at the end of the image 
// (it's optional, and probably not needed on embedded devices)
#if UNUSED
static uint8 findEOI(RiJpegState *state)
{
   uint8 c;
   uint8 status;

   // Prime the bit buffer
   state->gBitsLeft = 8;
   getBits1(state, 8);
   getBits1(state, 8);

   // The next marker _should_ be EOI
   status = processMarkers(state, &c);
   if (status)
      return status;
   else if (state->gCallbackStatus)
      return state->gCallbackStatus;
   
   //gTotalBytesRead -= in_buf_left;
   if (c != M_EOI)
      return PJPG_UNEXPECTED_MARKER;
   
   return 0;
}
#endif
//------------------------------------------------------------------------------
static uint8 checkHuffTables(RiJpegState *state)
{
   uint8 i;

   for (i = 0; i < state->gCompsInScan; i++)
   {
      uint8 compDCTab = state->gCompDCTab[state->gCompList[i]];
      uint8 compACTab = state->gCompACTab[state->gCompList[i]] + 2;
      
      if ( ((state->gValidHuffTables & (1 << compDCTab)) == 0) ||
           ((state->gValidHuffTables & (1 << compACTab)) == 0) )
         return PJPG_UNDEFINED_HUFF_TABLE;           
   }
   
   return 0;
}
//------------------------------------------------------------------------------
static uint8 checkQuantTables(RiJpegState *state)
{
   uint8 i;

   for (i = 0; i < state->gCompsInScan; i++)
   {
      uint8 compQuantMask = state->gCompQuant[state->gCompList[i]] ? 2 : 1;
      
      if ((state->gValidQuantTables & compQuantMask) == 0)
         return PJPG_UNDEFINED_QUANT_TABLE;
   }         

   return 0;         
}
//------------------------------------------------------------------------------
static uint8 initScan(RiJpegState *state)
{
   uint8 foundEOI;
   uint8 status = locateSOSMarker(state, &foundEOI);
   if (status)
      return status;
   if (foundEOI)
      return PJPG_UNEXPECTED_MARKER;
   
   status = checkHuffTables(state);
   if (status)
      return status;

   status = checkQuantTables(state);
   if (status)
      return status;

   state->gLastDC[0] = 0;
   state->gLastDC[1] = 0;
   state->gLastDC[2] = 0;

   if (state->gRestartInterval)
   {
      state->gRestartsLeft = state->gRestartInterval;
      state->gNextRestartNum = 0;
   }

   fixInBuffer(state);

   return 0;
}
//------------------------------------------------------------------------------
static uint8 initFrame(RiJpegState *state)
{
   if (state->gCompsInFrame == 1)
   {
      if ((state->gCompHSamp[0] != 1) || (state->gCompVSamp[0] != 1))
         return PJPG_UNSUPPORTED_SAMP_FACTORS;

      state->gScanType = PJPG_GRAYSCALE;

      state->gMaxBlocksPerMCU = 1;
      state->gMCUOrg[0] = 0;

      state->gMaxMCUXSize     = 8;
      state->gMaxMCUYSize     = 8;
   }
   else if (state->gCompsInFrame == 3)
   {
      if ( ((state->gCompHSamp[1] != 1) || (state->gCompVSamp[1] != 1)) ||
         ((state->gCompHSamp[2] != 1) || (state->gCompVSamp[2] != 1)) )
         return PJPG_UNSUPPORTED_SAMP_FACTORS;

      if ((state->gCompHSamp[0] == 1) && (state->gCompVSamp[0] == 1))
      {
         state->gScanType = PJPG_YH1V1;

         state->gMaxBlocksPerMCU = 3;
         state->gMCUOrg[0] = 0;
         state->gMCUOrg[1] = 1;
         state->gMCUOrg[2] = 2;
                  
         state->gMaxMCUXSize = 8;
         state->gMaxMCUYSize = 8;
      }
      else if ((state->gCompHSamp[0] == 1) && (state->gCompVSamp[0] == 2))
      {
         state->gScanType = PJPG_YH1V2;

         state->gMaxBlocksPerMCU = 4;
         state->gMCUOrg[0] = 0;
         state->gMCUOrg[1] = 0;
         state->gMCUOrg[2] = 1;
         state->gMCUOrg[3] = 2;

         state->gMaxMCUXSize = 8;
         state->gMaxMCUYSize = 16;
      }
      else if ((state->gCompHSamp[0] == 2) && (state->gCompVSamp[0] == 1))
      {
         state->gScanType = PJPG_YH2V1;

         state->gMaxBlocksPerMCU = 4;
         state->gMCUOrg[0] = 0;
         state->gMCUOrg[1] = 0;
         state->gMCUOrg[2] = 1;
         state->gMCUOrg[3] = 2;

         state->gMaxMCUXSize = 16;
         state->gMaxMCUYSize = 8;
      }
      else if ((state->gCompHSamp[0] == 2) && (state->gCompVSamp[0] == 2))
      {
         state->gScanType = PJPG_YH2V2;

         state->gMaxBlocksPerMCU = 6;
         state->gMCUOrg[0] = 0;
         state->gMCUOrg[1] = 0;
         state->gMCUOrg[2] = 0;
         state->gMCUOrg[3] = 0;
         state->gMCUOrg[4] = 1;
         state->gMCUOrg[5] = 2;

         state->gMaxMCUXSize = 16;
         state->gMaxMCUYSize = 16;
      }
      else
         return PJPG_UNSUPPORTED_SAMP_FACTORS;
   }
   else
      return PJPG_UNSUPPORTED_COLORSPACE;

   state->gMaxMCUSPerRow = (state->gImageXSize + (state->gMaxMCUXSize - 1)) >> ((state->gMaxMCUXSize == 8) ? 3 : 4);
   state->gMaxMCUSPerCol = (state->gImageYSize + (state->gMaxMCUYSize - 1)) >> ((state->gMaxMCUYSize == 8) ? 3 : 4);
   
   // This can overflow on large JPEG's.
   //gNumMCUSRemaining = state->gMaxMCUSPerRow * state->gMaxMCUSPerCol;
   state->gNumMCUSRemainingX = state->gMaxMCUSPerRow;
   state->gNumMCUSRemainingY = state->gMaxMCUSPerCol;
   
   return 0;
}
//----------------------------------------------------------------------------
// Winograd IDCT: 5 multiplies per row/col, up to 80 muls for the 2D IDCT

#define PJPG_DCT_SCALE_BITS 7

#define PJPG_DCT_SCALE (1U << PJPG_DCT_SCALE_BITS)

#define PJPG_DESCALE(x) PJPG_ARITH_SHIFT_RIGHT_N_16(((x) + (1 << (PJPG_DCT_SCALE_BITS - 1))), PJPG_DCT_SCALE_BITS)

#define PJPG_WFIX(x) ((x) * PJPG_DCT_SCALE + 0.5f)

#define PJPG_WINOGRAD_QUANT_SCALE_BITS 10

static const uint8 gWinogradQuant[] = 
{
   128,  178,  178,  167,  246,  167,  151,  232,
   232,  151,  128,  209,  219,  209,  128,  101,
   178,  197,  197,  178,  101,   69,  139,  167,
   177,  167,  139,   69,   35,   96,  131,  151,
   151,  131,   96,   35,   49,   91,  118,  128,
   118,   91,   49,   46,   81,  101,  101,   81,
   46,   42,   69,   79,   69,   42,   35,   54,
   54,   35,   28,   37,   28,   19,   19,   10,
};   

// Multiply quantization matrix by the Winograd IDCT scale factors
static void createWinogradQuant(RiJpegState *state, int16* pQuant)
{
   uint8 i;
   
   for (i = 0; i < 64; i++) 
   {
      long x = pQuant[i];
      x *= gWinogradQuant[i];
      pQuant[i] = (int16)((x + (1 << (PJPG_WINOGRAD_QUANT_SCALE_BITS - PJPG_DCT_SCALE_BITS - 1))) >> (PJPG_WINOGRAD_QUANT_SCALE_BITS - PJPG_DCT_SCALE_BITS));
   }
}

// These multiply helper functions are the 4 types of signed multiplies needed by the Winograd IDCT.
// A smart C compiler will optimize them to use 16x8 = 24 bit muls, if not you may need to tweak
// these functions or drop to CPU specific inline assembly.

// 1/cos(4*pi/16)
// 362, 256+106
static PJPG_INLINE int16 imul_b1_b3(RiJpegState *state, int16 w)
{
   long x = (w * 362L);
   x += 128L;
   return (int16)(PJPG_ARITH_SHIFT_RIGHT_8_L(x));
}

// 1/cos(6*pi/16)
// 669, 256+256+157
static PJPG_INLINE int16 imul_b2(RiJpegState *state, int16 w)
{
   long x = (w * 669L);
   x += 128L;
   return (int16)(PJPG_ARITH_SHIFT_RIGHT_8_L(x));
}

// 1/cos(2*pi/16)
// 277, 256+21
static PJPG_INLINE int16 imul_b4(RiJpegState *state, int16 w)
{
   long x = (w * 277L);
   x += 128L;
   return (int16)(PJPG_ARITH_SHIFT_RIGHT_8_L(x));
}

// 1/(cos(2*pi/16) + cos(6*pi/16))
// 196, 196
static PJPG_INLINE int16 imul_b5(RiJpegState *state, int16 w)
{
   long x = (w * 196L);
   x += 128L;
   return (int16)(PJPG_ARITH_SHIFT_RIGHT_8_L(x));
}

static PJPG_INLINE uint8 clamp(RiJpegState *state, int16 s)
{
   int32_t value=s;
   return value<0?0:value>255?255:(uint8)value;
}


static void idctRows(RiJpegState *state)
{
   uint8 i;
   int16* pSrc = state->gCoeffBuf;
            
   for (i = 0; i < 8; i++)
   {
      if ((pSrc[1] | pSrc[2] | pSrc[3] | pSrc[4] | pSrc[5] | pSrc[6] | pSrc[7]) == 0)
      {
         // Short circuit the 1D IDCT if only the DC component is non-zero
         int16 src0 = *pSrc;

         *(pSrc+1) = src0;
         *(pSrc+2) = src0;
         *(pSrc+3) = src0;
         *(pSrc+4) = src0;
         *(pSrc+5) = src0;
         *(pSrc+6) = src0;
         *(pSrc+7) = src0;
      }
      else
      {
         int16 src4 = *(pSrc+5);
         int16 src7 = *(pSrc+3);
         int16 x4  = src4 - src7;
         int16 x7  = src4 + src7;

         int16 src5 = *(pSrc+1);
         int16 src6 = *(pSrc+7);
         int16 x5  = src5 + src6;
         int16 x6  = src5 - src6;

         int16 tmp1 = imul_b5(state, x4 - x6);
         int16 stg26 = imul_b4(state, x6) - tmp1;

         int16 x24 = tmp1 - imul_b2(state, x4);

         int16 x15 = x5 - x7;
         int16 x17 = x5 + x7;

         int16 tmp2 = stg26 - x17;
         int16 tmp3 = imul_b1_b3(state, x15) - tmp2;
         int16 x44 = tmp3 + x24;

         int16 src0 = *(pSrc+0);
         int16 src1 = *(pSrc+4);
         int16 x30 = src0 + src1;
         int16 x31 = src0 - src1;

         int16 src2 = *(pSrc+2);
         int16 src3 = *(pSrc+6);
         int16 x12 = src2 - src3;
         int16 x13 = src2 + src3;

         int16 x32 = imul_b1_b3(state, x12) - x13;

         int16 x40 = x30 + x13;
         int16 x43 = x30 - x13;
         int16 x41 = x31 + x32;
         int16 x42 = x31 - x32;

         *(pSrc+0) = x40 + x17;
         *(pSrc+1) = x41 + tmp2;
         *(pSrc+2) = x42 + tmp3;
         *(pSrc+3) = x43 - x44;
         *(pSrc+4) = x43 + x44;
         *(pSrc+5) = x42 - tmp3;
         *(pSrc+6) = x41 - tmp2;
         *(pSrc+7) = x40 - x17;
      }
                  
      pSrc += 8;
   }      
}

static void idctCols(RiJpegState *state)
{
   uint8 i;
      
   int16* pSrc = state->gCoeffBuf;
   
   for (i = 0; i < 8; i++)
   {
      if ((pSrc[1*8] | pSrc[2*8] | pSrc[3*8] | pSrc[4*8] | pSrc[5*8] | pSrc[6*8] | pSrc[7*8]) == 0)
      {
         // Short circuit the 1D IDCT if only the DC component is non-zero
         uint8 c = clamp(state, PJPG_DESCALE(*pSrc) + 128);
         *(pSrc+0*8) = c;
         *(pSrc+1*8) = c;
         *(pSrc+2*8) = c;
         *(pSrc+3*8) = c;
         *(pSrc+4*8) = c;
         *(pSrc+5*8) = c;
         *(pSrc+6*8) = c;
         *(pSrc+7*8) = c;
      }
      else
      {
         int16 src4 = *(pSrc+5*8);
         int16 src7 = *(pSrc+3*8);
         int16 x4  = src4 - src7;
         int16 x7  = src4 + src7;

         int16 src5 = *(pSrc+1*8);
         int16 src6 = *(pSrc+7*8);
         int16 x5  = src5 + src6;
         int16 x6  = src5 - src6;

         int16 tmp1 = imul_b5(state, x4 - x6);
         int16 stg26 = imul_b4(state, x6) - tmp1;

         int16 x24 = tmp1 - imul_b2(state, x4);

         int16 x15 = x5 - x7;
         int16 x17 = x5 + x7;

         int16 tmp2 = stg26 - x17;
         int16 tmp3 = imul_b1_b3(state, x15) - tmp2;
         int16 x44 = tmp3 + x24;

         int16 src0 = *(pSrc+0*8);
         int16 src1 = *(pSrc+4*8);
         int16 x30 = src0 + src1;
         int16 x31 = src0 - src1;

         int16 src2 = *(pSrc+2*8);
         int16 src3 = *(pSrc+6*8);
         int16 x12 = src2 - src3;
         int16 x13 = src2 + src3;

         int16 x32 = imul_b1_b3(state, x12) - x13;

         int16 x40 = x30 + x13;
         int16 x43 = x30 - x13;
         int16 x41 = x31 + x32;
         int16 x42 = x31 - x32;

         // descale, convert to unsigned and clamp to 8-bit
         *(pSrc+0*8) = clamp(state, PJPG_DESCALE(x40 + x17)  + 128);
         *(pSrc+1*8) = clamp(state, PJPG_DESCALE(x41 + tmp2) + 128);
         *(pSrc+2*8) = clamp(state, PJPG_DESCALE(x42 + tmp3) + 128);
         *(pSrc+3*8) = clamp(state, PJPG_DESCALE(x43 - x44)  + 128);
         *(pSrc+4*8) = clamp(state, PJPG_DESCALE(x43 + x44)  + 128);
         *(pSrc+5*8) = clamp(state, PJPG_DESCALE(x42 - tmp3) + 128);
         *(pSrc+6*8) = clamp(state, PJPG_DESCALE(x41 - tmp2) + 128);
         *(pSrc+7*8) = clamp(state, PJPG_DESCALE(x40 - x17)  + 128);
      }

      pSrc++;      
   }      
}

/*----------------------------------------------------------------------------*/
static PJPG_INLINE uint8 addAndClamp(RiJpegState *state, uint8 a, int16 b)
{
   int32_t value=(int32_t)a+b;
   return value<0?0:value>255?255:(uint8)value;
}

/*----------------------------------------------------------------------------*/
static PJPG_INLINE uint8 subAndClamp(RiJpegState *state, uint8 a, int16 b)
{
   int32_t value=(int32_t)a-b;
   return value<0?0:value>255?255:(uint8)value;
}

/*----------------------------------------------------------------------------*/
// 103/256
//R = Y + 1.402 (Cr-128)

// 88/256, 183/256
//G = Y - 0.34414 (Cb-128) - 0.71414 (Cr-128)

// 198/256
//B = Y + 1.772 (Cb-128)
/*----------------------------------------------------------------------------*/
// Cb upsample and accumulate, 4x4 to 8x8
static void upsampleCb(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cb - affects G and B
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   uint8* pDstB = state->gMCUBufB + dstOfs;
   for (y = 0; y < 4; y++)
   {
      for (x = 0; x < 4; x++)
      {
         uint8 cb = (uint8)*pSrc++;
         int16 cbG, cbB;

         cbG = ((cb * 88U) >> 8U) - 44L;
         pDstG[0] = subAndClamp(state, pDstG[0], cbG);
         pDstG[1] = subAndClamp(state, pDstG[1], cbG);
         pDstG[8] = subAndClamp(state, pDstG[8], cbG);
         pDstG[9] = subAndClamp(state, pDstG[9], cbG);

         cbB = (cb + ((cb * 198U) >> 8U)) - 227L;
         pDstB[0] = addAndClamp(state, pDstB[0], cbB);
         pDstB[1] = addAndClamp(state, pDstB[1], cbB);
         pDstB[8] = addAndClamp(state, pDstB[8], cbB);
         pDstB[9] = addAndClamp(state, pDstB[9], cbB);

         pDstG += 2;
         pDstB += 2;
      }

      pSrc = pSrc - 4 + 8;
      pDstG = pDstG - 8 + 16;
      pDstB = pDstB - 8 + 16;
   }
}   
/*----------------------------------------------------------------------------*/
// Cb upsample and accumulate, 4x8 to 8x8
static void upsampleCbH(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cb - affects G and B
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   uint8* pDstB = state->gMCUBufB + dstOfs;
   for (y = 0; y < 8; y++)
   {
      for (x = 0; x < 4; x++)
      {
         uint8 cb = (uint8)*pSrc++;
         int16 cbG, cbB;

         cbG = ((cb * 88U) >> 8U) - 44L;
         pDstG[0] = subAndClamp(state, pDstG[0], cbG);
         pDstG[1] = subAndClamp(state, pDstG[1], cbG);

         cbB = (cb + ((cb * 198U) >> 8U)) - 227L;
         pDstB[0] = addAndClamp(state, pDstB[0], cbB);
         pDstB[1] = addAndClamp(state, pDstB[1], cbB);

         pDstG += 2;
         pDstB += 2;
      }

      pSrc = pSrc - 4 + 8;
   }
}   
/*----------------------------------------------------------------------------*/
// Cb upsample and accumulate, 8x4 to 8x8
static void upsampleCbV(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cb - affects G and B
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   uint8* pDstB = state->gMCUBufB + dstOfs;
   for (y = 0; y < 4; y++)
   {
      for (x = 0; x < 8; x++)
      {
         uint8 cb = (uint8)*pSrc++;
         int16 cbG, cbB;

         cbG = ((cb * 88U) >> 8U) - 44L;
         pDstG[0] = subAndClamp(state, pDstG[0], cbG);
         pDstG[8] = subAndClamp(state, pDstG[8], cbG);

         cbB = (cb + ((cb * 198U) >> 8U)) - 227L;
         pDstB[0] = addAndClamp(state, pDstB[0], cbB);
         pDstB[8] = addAndClamp(state, pDstB[8], cbB);

         ++pDstG;
         ++pDstB;
      }

      pDstG = pDstG - 8 + 16;
      pDstB = pDstB - 8 + 16;
   }
}   
/*----------------------------------------------------------------------------*/
// 103/256
//R = Y + 1.402 (Cr-128)

// 88/256, 183/256
//G = Y - 0.34414 (Cb-128) - 0.71414 (Cr-128)

// 198/256
//B = Y + 1.772 (Cb-128)
/*----------------------------------------------------------------------------*/
// Cr upsample and accumulate, 4x4 to 8x8
static void upsampleCr(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cr - affects R and G
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstR = state->gMCUBufR + dstOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   for (y = 0; y < 4; y++)
   {
      for (x = 0; x < 4; x++)
      {
         uint8 cr = (uint8)*pSrc++;
         int16 crR, crG;

         crR = (cr + ((cr * 103U) >> 8U)) - 179L;
         pDstR[0] = addAndClamp(state, pDstR[0], crR);
         pDstR[1] = addAndClamp(state, pDstR[1], crR);
         pDstR[8] = addAndClamp(state, pDstR[8], crR);
         pDstR[9] = addAndClamp(state, pDstR[9], crR);
         
         crG = ((cr * 183U) >> 8U) - 91L;
         pDstG[0] = subAndClamp(state, pDstG[0], crG);
         pDstG[1] = subAndClamp(state, pDstG[1], crG);
         pDstG[8] = subAndClamp(state, pDstG[8], crG);
         pDstG[9] = subAndClamp(state, pDstG[9], crG);
         
         pDstR += 2;
         pDstG += 2;
      }

      pSrc = pSrc - 4 + 8;
      pDstR = pDstR - 8 + 16;
      pDstG = pDstG - 8 + 16;
   }
}   
/*----------------------------------------------------------------------------*/
// Cr upsample and accumulate, 4x8 to 8x8
static void upsampleCrH(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cr - affects R and G
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstR = state->gMCUBufR + dstOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   for (y = 0; y < 8; y++)
   {
      for (x = 0; x < 4; x++)
      {
         uint8 cr = (uint8)*pSrc++;
         int16 crR, crG;

         crR = (cr + ((cr * 103U) >> 8U)) - 179L;
         pDstR[0] = addAndClamp(state, pDstR[0], crR);
         pDstR[1] = addAndClamp(state, pDstR[1], crR);
         
         crG = ((cr * 183U) >> 8U) - 91L;
         pDstG[0] = subAndClamp(state, pDstG[0], crG);
         pDstG[1] = subAndClamp(state, pDstG[1], crG);
         
         pDstR += 2;
         pDstG += 2;
      }

      pSrc = pSrc - 4 + 8;
   }
}   
/*----------------------------------------------------------------------------*/
// Cr upsample and accumulate, 8x4 to 8x8
static void upsampleCrV(RiJpegState *state, uint8 srcOfs, uint8 dstOfs)
{
   // Cr - affects R and G
   uint8 x, y;
   int16* pSrc = state->gCoeffBuf + srcOfs;
   uint8* pDstR = state->gMCUBufR + dstOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   for (y = 0; y < 4; y++)
   {
      for (x = 0; x < 8; x++)
      {
         uint8 cr = (uint8)*pSrc++;
         int16 crR, crG;

         crR = (cr + ((cr * 103U) >> 8U)) - 179L;
         pDstR[0] = addAndClamp(state, pDstR[0], crR);
         pDstR[8] = addAndClamp(state, pDstR[8], crR);

         crG = ((cr * 183U) >> 8U) - 91L;
         pDstG[0] = subAndClamp(state, pDstG[0], crG);
         pDstG[8] = subAndClamp(state, pDstG[8], crG);

         ++pDstR;
         ++pDstG;
      }

      pDstR = pDstR - 8 + 16;
      pDstG = pDstG - 8 + 16;
   }
} 
/*----------------------------------------------------------------------------*/
// Convert Y to RGB
static void copyY(RiJpegState *state, uint8 dstOfs)
{
   uint8 i;
   uint8* pRDst = state->gMCUBufR + dstOfs;
   uint8* pGDst = state->gMCUBufG + dstOfs;
   uint8* pBDst = state->gMCUBufB + dstOfs;
   int16* pSrc = state->gCoeffBuf;
   
   for (i = 64; i > 0; i--)
   {
      uint8 c = (uint8)*pSrc++;
      
      *pRDst++ = c;
      *pGDst++ = c;
      *pBDst++ = c;
   }
}
/*----------------------------------------------------------------------------*/
// Cb convert to RGB and accumulate
static void convertCb(RiJpegState *state, uint8 dstOfs)
{
   uint8 i;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   uint8* pDstB = state->gMCUBufB + dstOfs;
   int16* pSrc = state->gCoeffBuf;

   for (i = 64; i > 0; i--)
   {
      uint8 cb = (uint8)*pSrc++;
      int16 cbG, cbB;

      cbG = ((cb * 88U) >> 8U) - 44L;
      pDstG[0] = subAndClamp(state, pDstG[0], cbG);
      ++pDstG;

      cbB = (cb + ((cb * 198U) >> 8U)) - 227L;
      pDstB[0] = addAndClamp(state, pDstB[0], cbB);
      ++pDstB;
   }
}
/*----------------------------------------------------------------------------*/
// Cr convert to RGB and accumulate
static void convertCr(RiJpegState *state, uint8 dstOfs)
{
   uint8 i;
   uint8* pDstR = state->gMCUBufR + dstOfs;
   uint8* pDstG = state->gMCUBufG + dstOfs;
   int16* pSrc = state->gCoeffBuf;

   for (i = 64; i > 0; i--)
   {
      uint8 cr = (uint8)*pSrc++;
      int16 crR, crG;

      crR = (cr + ((cr * 103U) >> 8U)) - 179L;
      pDstR[0] = addAndClamp(state, pDstR[0], crR);
      ++pDstR;

      crG = ((cr * 183U) >> 8U) - 91L;
      pDstG[0] = subAndClamp(state, pDstG[0], crG);
      ++pDstG;
   }
}
/*----------------------------------------------------------------------------*/
static void transformBlock(RiJpegState *state, uint8 mcuBlock)
{
   idctRows(state);
   idctCols(state);
   
   switch (state->gScanType)
   {
      case PJPG_GRAYSCALE:
      {
         // MCU size: 1, 1 block per MCU
         copyY(state, 0);
         break;
      }
      case PJPG_YH1V1:
      {
         // MCU size: 8x8, 3 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               copyY(state, 0);
               break;
            }
            case 1:
            {
               convertCb(state, 0);
               break;
            }
            case 2:
            {
               convertCr(state, 0);
               break;
            }
         }

         break;
      }
      case PJPG_YH1V2:
      {
         // MCU size: 8x16, 4 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               copyY(state, 0);
               break;
            }
            case 1:
            {
               copyY(state, 128);
               break;
            }
            case 2:
            {
               upsampleCbV(state, 0, 0);
               upsampleCbV(state, 4*8, 128);
               break;
            }
            case 3:
            {
               upsampleCrV(state, 0, 0);
               upsampleCrV(state, 4*8, 128);
               break;
            }
         }

         break;
      }        
      case PJPG_YH2V1:
      {
         // MCU size: 16x8, 4 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               copyY(state, 0);
               break;
            }
            case 1:
            {
               copyY(state, 64);
               break;
            }
            case 2:
            {
               upsampleCbH(state, 0, 0);
               upsampleCbH(state, 4, 64);
               break;
            }
            case 3:
            {
               upsampleCrH(state, 0, 0);
               upsampleCrH(state, 4, 64);
               break;
            }
         }
         
         break;
      }        
      case PJPG_YH2V2:
      {
         // MCU size: 16x16, 6 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               copyY(state, 0);
               break;
            }
            case 1:
            {
               copyY(state, 64);
               break;
            }
            case 2:
            {
               copyY(state, 128);
               break;
            }
            case 3:
            {
               copyY(state, 192);
               break;
            }
            case 4:
            {
               upsampleCb(state, 0, 0);
               upsampleCb(state, 4, 64);
               upsampleCb(state, 4*8, 128);
               upsampleCb(state, 4+4*8, 192);
               break;
            }
            case 5:
            {
               upsampleCr(state, 0, 0);
               upsampleCr(state, 4, 64);
               upsampleCr(state, 4*8, 128);
               upsampleCr(state, 4+4*8, 192);
               break;
            }
         }

         break;
      }         
   }      
}
//------------------------------------------------------------------------------
static void transformBlockReduce(RiJpegState *state, uint8 mcuBlock)
{
   uint8 c = clamp(state, PJPG_DESCALE(state->gCoeffBuf[0]) + 128);
   int16 cbG, cbB, crR, crG;

   switch (state->gScanType)
   {
      case PJPG_GRAYSCALE:
      {
         // MCU size: 1, 1 block per MCU
         state->gMCUBufR[0] = c;
         break;
      }
      case PJPG_YH1V1:
      {
         // MCU size: 8x8, 3 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               state->gMCUBufR[0] = c;
               state->gMCUBufG[0] = c;
               state->gMCUBufB[0] = c;
               break;
            }
            case 1:
            {
               cbG = ((c * 88U) >> 8U) - 44L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], cbG);

               cbB = (c + ((c * 198U) >> 8U)) - 227L;
               state->gMCUBufB[0] = addAndClamp(state, state->gMCUBufB[0], cbB);
               break;
            }
            case 2:
            {
               crR = (c + ((c * 103U) >> 8U)) - 179L;
               state->gMCUBufR[0] = addAndClamp(state, state->gMCUBufR[0], crR);

               crG = ((c * 183U) >> 8U) - 91L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], crG);
               break;
            }
         }

         break;
      }
      case PJPG_YH1V2:
      {
         // MCU size: 8x16, 4 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               state->gMCUBufR[0] = c;
               state->gMCUBufG[0] = c;
               state->gMCUBufB[0] = c;
               break;
            }
            case 1:
            {
               state->gMCUBufR[128] = c;
               state->gMCUBufG[128] = c;
               state->gMCUBufB[128] = c;
               break;
            }
            case 2:
            {
               cbG = ((c * 88U) >> 8U) - 44L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], cbG);
               state->gMCUBufG[128] = subAndClamp(state, state->gMCUBufG[128], cbG);

               cbB = (c + ((c * 198U) >> 8U)) - 227L;
               state->gMCUBufB[0] = addAndClamp(state, state->gMCUBufB[0], cbB);
               state->gMCUBufB[128] = addAndClamp(state, state->gMCUBufB[128], cbB);

               break;
            }
            case 3:
            {
               crR = (c + ((c * 103U) >> 8U)) - 179L;
               state->gMCUBufR[0] = addAndClamp(state, state->gMCUBufR[0], crR);
               state->gMCUBufR[128] = addAndClamp(state, state->gMCUBufR[128], crR);

               crG = ((c * 183U) >> 8U) - 91L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], crG);
               state->gMCUBufG[128] = subAndClamp(state, state->gMCUBufG[128], crG);

               break;
            }
         }
         break;
      }
      case PJPG_YH2V1:
      {
         // MCU size: 16x8, 4 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               state->gMCUBufR[0] = c;
               state->gMCUBufG[0] = c;
               state->gMCUBufB[0] = c;
               break;
            }
            case 1:
            {
               state->gMCUBufR[64] = c;
               state->gMCUBufG[64] = c;
               state->gMCUBufB[64] = c;
               break;
            }
            case 2:
            {
               cbG = ((c * 88U) >> 8U) - 44L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], cbG);
               state->gMCUBufG[64] = subAndClamp(state, state->gMCUBufG[64], cbG);

               cbB = (c + ((c * 198U) >> 8U)) - 227L;
               state->gMCUBufB[0] = addAndClamp(state, state->gMCUBufB[0], cbB);
               state->gMCUBufB[64] = addAndClamp(state, state->gMCUBufB[64], cbB);

               break;
            }
            case 3:
            {
               crR = (c + ((c * 103U) >> 8U)) - 179L;
               state->gMCUBufR[0] = addAndClamp(state, state->gMCUBufR[0], crR);
               state->gMCUBufR[64] = addAndClamp(state, state->gMCUBufR[64], crR);

               crG = ((c * 183U) >> 8U) - 91L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], crG);
               state->gMCUBufG[64] = subAndClamp(state, state->gMCUBufG[64], crG);

               break;
            }
         }
         break;
      }
      case PJPG_YH2V2:
      {
         // MCU size: 16x16, 6 blocks per MCU
         switch (mcuBlock)
         {
            case 0:
            {
               state->gMCUBufR[0] = c;
               state->gMCUBufG[0] = c;
               state->gMCUBufB[0] = c;
               break;
            }
            case 1:
            {
               state->gMCUBufR[64] = c;
               state->gMCUBufG[64] = c;
               state->gMCUBufB[64] = c;
               break;
            }
            case 2:
            {
               state->gMCUBufR[128] = c;
               state->gMCUBufG[128] = c;
               state->gMCUBufB[128] = c;
               break;
            }
            case 3:
            {
               state->gMCUBufR[192] = c;
               state->gMCUBufG[192] = c;
               state->gMCUBufB[192] = c;
               break;
            }
            case 4:
            {
               cbG = ((c * 88U) >> 8U) - 44L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], cbG);
               state->gMCUBufG[64] = subAndClamp(state, state->gMCUBufG[64], cbG);
               state->gMCUBufG[128] = subAndClamp(state, state->gMCUBufG[128], cbG);
               state->gMCUBufG[192] = subAndClamp(state, state->gMCUBufG[192], cbG);

               cbB = (c + ((c * 198U) >> 8U)) - 227L;
               state->gMCUBufB[0] = addAndClamp(state, state->gMCUBufB[0], cbB);
               state->gMCUBufB[64] = addAndClamp(state, state->gMCUBufB[64], cbB);
               state->gMCUBufB[128] = addAndClamp(state, state->gMCUBufB[128], cbB);
               state->gMCUBufB[192] = addAndClamp(state, state->gMCUBufB[192], cbB);

               break;
            }
            case 5:
            {
               crR = (c + ((c * 103U) >> 8U)) - 179L;
               state->gMCUBufR[0] = addAndClamp(state, state->gMCUBufR[0], crR);
               state->gMCUBufR[64] = addAndClamp(state, state->gMCUBufR[64], crR);
               state->gMCUBufR[128] = addAndClamp(state, state->gMCUBufR[128], crR);
               state->gMCUBufR[192] = addAndClamp(state, state->gMCUBufR[192], crR);

               crG = ((c * 183U) >> 8U) - 91L;
               state->gMCUBufG[0] = subAndClamp(state, state->gMCUBufG[0], crG);
               state->gMCUBufG[64] = subAndClamp(state, state->gMCUBufG[64], crG);
               state->gMCUBufG[128] = subAndClamp(state, state->gMCUBufG[128], crG);
               state->gMCUBufG[192] = subAndClamp(state, state->gMCUBufG[192], crG);

               break;
            }
         }
         break;
      }
   }
}
//------------------------------------------------------------------------------
static uint8 decodeNextMCU(RiJpegState *state)
{
   uint8 status;
   uint8 mcuBlock;   

   if (state->gRestartInterval) 
   {
      if (state->gRestartsLeft == 0)
      {
         status = processRestart(state);
         if (status)
            return status;
      }
      state->gRestartsLeft--;
   }      
   
   for (mcuBlock = 0; mcuBlock < state->gMaxBlocksPerMCU; mcuBlock++)
   {
      uint8 componentID = state->gMCUOrg[mcuBlock];
      uint8 compQuant = state->gCompQuant[componentID];	
      uint8 compDCTab = state->gCompDCTab[componentID];
      uint8 numExtraBits, compACTab, k;
      const int16* pQ = compQuant ? state->gQuant1 : state->gQuant0;
      uint16 r; int16 dc;

      uint8 s = huffDecode(state, compDCTab ? &state->gHuffTab1 : &state->gHuffTab0, compDCTab ? state->gHuffVal1 : state->gHuffVal0);
      
      r = 0;
      numExtraBits = s & 0xF;
      if (numExtraBits)
         r = getBits2(state, numExtraBits);
      dc = huffExtend(state, r, s);
            
      dc = dc + state->gLastDC[componentID];
      if(dc < -2048 || dc > 2047)return PJPG_DECODE_ERROR;
      state->gLastDC[componentID] = dc;
            
      state->gCoeffBuf[0] = dc * pQ[0];
      if(state->gCoeffBuf[0] < -32768L || state->gCoeffBuf[0] > 32767)return PJPG_DECODE_ERROR;

      compACTab = state->gCompACTab[componentID];

      if (state->gReduce)
      {
         // Decode, but throw out the AC coefficients in reduce mode.
         for (k = 1; k < 64; k++)
         {
            s = huffDecode(state, compACTab ? &state->gHuffTab3 : &state->gHuffTab2, compACTab ? state->gHuffVal3 : state->gHuffVal2);

            numExtraBits = s & 0xF;
            if (numExtraBits)
               getBits2(state, numExtraBits);

            r = s >> 4;
            s &= 15;

            if (s)
            {
               if (r)
               {
                  if ((k + r) > 63)
                     return PJPG_DECODE_ERROR;

                  k = (uint8)(k + r);
               }
            }
            else
            {
               if (r == 15)
               {
                  if ((k + 16) > 64)
                     return PJPG_DECODE_ERROR;

                  k += (16 - 1); // - 1 because the loop counter is k
               }
               else
                  break;
            }
         }

         transformBlockReduce(state, mcuBlock); 
      }
      else
      {
         // Decode and dequantize AC coefficients
         for (k = 1; k < 64; k++)
         {
            uint16 extraBits;

            s = huffDecode(state, compACTab ? &state->gHuffTab3 : &state->gHuffTab2, compACTab ? state->gHuffVal3 : state->gHuffVal2);

            extraBits = 0;
            numExtraBits = s & 0xF;
            if (numExtraBits)
               extraBits = getBits2(state, numExtraBits);

            r = s >> 4;
            s &= 15;

            if (s)
            {
               int16 ac;

               if (r)
               {
                  if ((k + r) > 63)
                     return PJPG_DECODE_ERROR;

                  while (r)
                  {
                     state->gCoeffBuf[ZAG[k++]] = 0;
                     r--;
                  }
               }

               ac = huffExtend(state, extraBits, s);
               
               state->gCoeffBuf[ZAG[k]] = ac * pQ[k];
               if(state->gCoeffBuf[ZAG[k]] < -32768L || state->gCoeffBuf[ZAG[k]] > 32767)return PJPG_DECODE_ERROR; 
            }
            else
            {
               if (r == 15)
               {
                  if ((k + 16) > 64)
                     return PJPG_DECODE_ERROR;
                  
                  for (r = 16; r > 0; r--)
                     state->gCoeffBuf[ZAG[k++]] = 0;
                  
                  k--; // - 1 because the loop counter is k
               }
               else
                  break;
            }
         }
         
         while (k < 64)
            state->gCoeffBuf[ZAG[k++]] = 0;

         transformBlock(state, mcuBlock); 
      }
   }
         
   return 0;
}
//------------------------------------------------------------------------------
static unsigned char pjpeg_decode_mcu(RiJpegState *state)
{
   uint8 status;
   
   if (state->gCallbackStatus)
      return state->gCallbackStatus;
   
   if ((!state->gNumMCUSRemainingX) && (!state->gNumMCUSRemainingY))
      return PJPG_NO_MORE_BLOCKS;
         
   status = decodeNextMCU(state);
   if ((status) || (state->gCallbackStatus))
      return state->gCallbackStatus ? state->gCallbackStatus : status;
      
   state->gNumMCUSRemainingX--;
   if (!state->gNumMCUSRemainingX)
   {
      state->gNumMCUSRemainingY--;
	  if (state->gNumMCUSRemainingY > 0)
		  state->gNumMCUSRemainingX = state->gMaxMCUSPerRow;
   }
   
   return 0;
}
//------------------------------------------------------------------------------
static unsigned char pjpeg_decode_init(RiJpegState *state, pjpeg_image_info_t *pInfo, pjpeg_need_bytes_callback_t pNeed_bytes_callback, void *pCallback_data, unsigned char reduce)
{
   uint8 status;
   
   pInfo->m_width = 0; pInfo->m_height = 0; pInfo->m_comps = 0;
   pInfo->m_MCUSPerRow = 0; pInfo->m_MCUSPerCol = 0;
   pInfo->m_scanType = PJPG_GRAYSCALE;
   pInfo->m_MCUWidth = 0; pInfo->m_MCUHeight = 0;
   pInfo->m_pMCUBufR = (unsigned char*)0; pInfo->m_pMCUBufG = (unsigned char*)0; pInfo->m_pMCUBufB = (unsigned char*)0;

   state->g_pNeedBytesCallback = pNeed_bytes_callback;
   state->g_pCallback_data = pCallback_data;
   state->gCallbackStatus = 0;
   state->gReduce = reduce;
    
   status = init(state);
   if ((status) || (state->gCallbackStatus))
      return state->gCallbackStatus ? state->gCallbackStatus : status;
   
   status = locateSOFMarker(state);
   if ((status) || (state->gCallbackStatus))
      return state->gCallbackStatus ? state->gCallbackStatus : status;

   status = initFrame(state);
   if ((status) || (state->gCallbackStatus))
      return state->gCallbackStatus ? state->gCallbackStatus : status;

   status = initScan(state);
   if ((status) || (state->gCallbackStatus))
      return state->gCallbackStatus ? state->gCallbackStatus : status;

   pInfo->m_width = state->gImageXSize; pInfo->m_height = state->gImageYSize; pInfo->m_comps = state->gCompsInFrame;
   pInfo->m_scanType = state->gScanType;
   pInfo->m_MCUSPerRow = state->gMaxMCUSPerRow; pInfo->m_MCUSPerCol = state->gMaxMCUSPerCol;
   pInfo->m_MCUWidth = state->gMaxMCUXSize; pInfo->m_MCUHeight = state->gMaxMCUYSize;
   pInfo->m_pMCUBufR = state->gMCUBufR; pInfo->m_pMCUBufG = state->gMCUBufG; pInfo->m_pMCUBufB = state->gMCUBufB;
      
   return 0;
}
