import { Buffer } from "lib/text";
import { Screen } from "std/curses";
extern "C" {
    fn rfl_text_paint(buffer: *mut u16, y: i16, x: i16, row: u32, left: u32, width: u16, tabstop: u16, styles: *const u32, selected: u32, from: u32, to: u32) -> i16;
    fn rfl_text_input(buffer: *mut u16, cursor: u32, first: u32, literal: i16, textwidth: u16, tabstop: u16, result: *mut u32) -> i16;
    fn rfl_text_input_count() -> u16;
    fn rfl_text_input_scalar(index: u16) -> u32;
}

/// Scalars from the most recent synchronous input run, for vi change recording.
export fn input_count() -> u16 {
    rfl_text_input_count()
}

export fn input_scalar(index: u16) -> u32 {
    rfl_text_input_scalar(index)
}

/// Inserts a ready input burst directly in C; zero means only one typed scalar.
export fn input_run(buffer: &Buffer, cursor: usize, first: u32, literal: bool, textwidth: u16, tabstop: u16) -> Result<Option<usize>, String> {
    let raw = buffer.state.borrow();
    let mut result: u32 = 0;
    let status = unsafe {
        rfl_text_input(*raw, cursor as u32, first, if (literal) {
            1
        } else {
            0
        }, textwidth, tabstop, &mut result)
    };
    if (status < 0) {
        Err("Bulk input failed; check file size and text limits")
    } else if (status == 0) {
        Ok(None)
    } else {
        Ok(Some(result as usize))
    }
}

/// Renders a highlighted text row directly into the default screen, without
/// allocating a temporary cell vector. The first seven palette entries match
/// Buffer.cells; additional application theme roles are ignored.
/// Returns -1 for invalid dimensions/palette or failure, 0 when the row fits,
/// and 1 for right overflow, computed during the same rendering pass.
export fn paint_line(screen: &Screen, buffer: &Buffer, y: i16, x: i16, row: usize, left: usize, width: u16, tabstop: u16, styles: Vec<u32>, selected: u32, from: usize, to: usize) -> i16 {
    if (width > 512 || styles.len() < 7 || y < 0 || y >= screen.rows() || x < 0 || x >= screen.columns()) {
        return -1;
    }
    let raw = buffer.state.borrow();
    unsafe {
        rfl_text_paint(*raw, y, x, row as u32, left as u32, width, tabstop, &styles[0], selected, from as u32, to as u32)
    }
}

/// Compatibility wrapper; paint_line additionally reports right overflow (1).
export fn paint(screen: &Screen, buffer: &Buffer, y: i16, x: i16, row: usize, left: usize, width: u16, tabstop: u16, styles: Vec<u32>, selected: u32, from: usize, to: usize) -> bool {
    paint_line(screen, buffer, y, x, row, left, width, tabstop, styles, selected, from, to) >= 0
}
