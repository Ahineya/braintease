impl<T> Option<T> {
    // Failure terminates execution; it does not unwind resource cleanup.
    /// Returns the `Some` payload; terminates execution on `None`. Failure does not unwind resource cleanup.
    export fn unwrap(self) -> T {
        __expect_value(move(self), "called Option.unwrap() on None")
    }

    /// Returns the `Some` payload; terminates execution with `message` on `None`, without unwinding cleanup.
    export fn expect(self, message: String) -> T {
        __expect_value(move(self), message)
    }

    /// Returns whether the option contains a value.
    export fn is_some(self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    /// Returns whether the option is `None`.
    export fn is_none(self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    /// Returns the contained value or the already-evaluated `fallback`.
    export fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(found) => found,
            None => fallback,
        }
    }

    /// Returns the contained value, or calls `fallback` only for `None`.
    export fn unwrap_or_else(self, fallback: fn() -> T) -> T {
        match self {
            Some(found) => found,
            None => fallback(),
        }
    }

    /// Transforms a `Some` payload with `f`; preserves `None` without calling `f`.
    export fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Some(found) => Some(f(found)),
            None => None,
        }
    }

    /// Calls `f` on a `Some` payload and returns its option; preserves `None`.
    export fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Some(found) => f(found),
            None => None,
        }
    }

    /// Preserves `Some`, or calls `fallback` only for `None`.
    export fn or_else(self, fallback: fn() -> Option<T>) -> Option<T> {
        match self {
            Some(found) => Some(found),
            None => fallback(),
        }
    }

    /// Preserves a `Some` payload only when `predicate` returns true; otherwise returns `None`.
    export fn filter(self, predicate: fn(T) -> bool) -> Option<T> {
        match self {
            Some(found) => if (predicate(found)) { Some(found) } else { None },
            None => None,
        }
    }
}

/// Returns whether the option contains a value.
export fn is_some<T>(value: Option<T>) -> bool { value.is_some() }

/// Returns whether the option is `None`.
export fn is_none<T>(value: Option<T>) -> bool { value.is_none() }

/// Returns the contained value or the already-evaluated `fallback`.
export fn unwrap_or<T>(value: Option<T>, fallback: T) -> T { value.unwrap_or(fallback) }

/// Transforms a `Some` payload with `f`; preserves `None` without calling `f`.
export fn map<T, U>(value: Option<T>, f: fn(T) -> U) -> Option<U> { value.map(f) }

/// Calls `f` on a `Some` payload and returns its option; preserves `None`.
export fn and_then<T, U>(value: Option<T>, f: fn(T) -> Option<U>) -> Option<U> { value.and_then(f) }
