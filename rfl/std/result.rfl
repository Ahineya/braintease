impl<T, E> Result<T, E> {
    // Error values need no formatting bound. Failure does not unwind cleanup.
    /// Returns the `Ok` payload; terminates execution on `Err` without requiring the error to be printable or unwinding cleanup.
    export fn unwrap(self) -> T {
        __expect_value(move(self), "called Result.unwrap() on Err")
    }

    /// Returns the `Ok` payload; terminates execution with `message` on `Err`, without unwinding cleanup.
    export fn expect(self, message: String) -> T {
        __expect_value(move(self), message)
    }

    /// Returns whether the result contains a successful value.
    export fn is_ok(self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    /// Returns whether the result contains an error.
    export fn is_err(self) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }

    /// Returns the successful value or the already-evaluated `fallback`.
    export fn unwrap_or(self, fallback: T) -> T {
        match self {
            Ok(found) => found,
            Err(_) => fallback,
        }
    }

    /// Returns the successful value, or calls `fallback` with the error only for `Err`.
    export fn unwrap_or_else(self, fallback: fn(E) -> T) -> T {
        match self {
            Ok(found) => found,
            Err(error) => fallback(error),
        }
    }

    /// Transforms an `Ok` payload with `f`; preserves `Err` without calling `f`.
    export fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(found) => Ok(f(found)),
            Err(error) => Err(error),
        }
    }

    /// Transforms an `Err` payload with `f`; preserves `Ok` without calling `f`.
    export fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(found) => Ok(found),
            Err(error) => Err(f(error)),
        }
    }

    /// Calls `f` on an `Ok` payload and returns its result; preserves `Err`.
    export fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(found) => f(found),
            Err(error) => Err(error),
        }
    }

    /// Preserves `Ok`, or calls `fallback` with the error to produce a replacement result.
    export fn or_else<F>(self, fallback: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Ok(found) => Ok(found),
            Err(error) => fallback(error),
        }
    }
}

/// Returns whether the result contains a successful value.
export fn is_ok<T, E>(value: Result<T, E>) -> bool { value.is_ok() }

/// Returns whether the result contains an error.
export fn is_err<T, E>(value: Result<T, E>) -> bool { value.is_err() }

/// Returns the successful value or the already-evaluated `fallback`.
export fn unwrap_or<T, E>(value: Result<T, E>, fallback: T) -> T { value.unwrap_or(fallback) }

/// Transforms an `Ok` payload with `f`; preserves `Err` without calling `f`.
export fn map<T, E, U>(value: Result<T, E>, f: fn(T) -> U) -> Result<U, E> { value.map(f) }

/// Calls `f` on an `Ok` payload and returns its result; preserves `Err`.
export fn and_then<T, E, U>(value: Result<T, E>, f: fn(T) -> Result<U, E>) -> Result<U, E> { value.and_then(f) }
