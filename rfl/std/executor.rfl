import { Context, Waker, task_set } from "std/task";
import { Future, Poll, Pending, Ready } from "std/future";

// turn pumps bounded external work even with runnable tasks. Some(0) forbids
// sleeping; other hints bound idle waiting. None still requires servicing I/O.
// false requests orderly stop. now is wrapping, monotonic milliseconds.
/// Supplies wrapping monotonic milliseconds and bounded I/O service/idle turns to an executor.
export trait Reactor {
    /// Returns wrapping monotonic milliseconds. Forward samples must stay within the half-range window.
    fn now(&self) -> u32;
    /// Services bounded external work and optionally idles. `Some(0)` forbids sleeping; other hints bound waiting, and `None` still requires I/O service. Return false to stop.
    fn turn(&mut self, wait:Option<u32>) -> bool;
}
/// Executor failure: reactor stopped, turn budget exhausted, invalid clock sample, or unavailable task capacity.
export type RunError = ReactorStopped | TurnBudgetExceeded | InvalidClock | TaskCapacity;

/// Drives a borrowed future until completion, servicing the reactor between polls. Executor failure cancels the future and returns `RunError`.
export fn block_on<F:Future, R:Reactor>(future:&mut F, reactor:&mut R) -> Result<F::Output, RunError> {
    drive(future, reactor, None)
}
/// Drives a future for at most `turns` reactor turns. Exhaustion cancels it and returns `TurnBudgetExceeded`.
export fn block_on_with_budget<F:Future, R:Reactor>(future:&mut F, reactor:&mut R, turns:u32) -> Result<F::Output, RunError> {
    drive(future, reactor, Some(turns))
}
fn drive<F:Future, R:Reactor>(future:&mut F, reactor:&mut R, limit:Option<u32>) -> Result<F::Output, RunError> {
    let queue=match task_set(1, reactor.now()) { Ok(q)=>q, Err(_)=>{ future.cancel(); return Err(TaskCapacity); } };
    let waker=match queue.allocate() { Ok(w)=>w, Err(_)=>{ future.cancel(); return Err(TaskCapacity); } };
    let mut used:u32=0;
    let mut error=ReactorStopped;
    while (true) {
        match limit { Some(max)=>{ if (used == max) { error=TurnBudgetExceeded; break; } used += 1; }, None=>{} }
        if (!reactor.turn(queue.wait_hint())) { break; }
        let now=reactor.now();
        if (!queue.tick(now)) { error=InvalidClock; break; }
        if (waker.take_ready()) {
            let mut cx=Context { waker:waker, now:now };
            match future.poll(&mut cx) {
                Ready(value)=>{ waker.retire(); return Ok(move(value)); },
                Pending=>{},
            }
        }
    }
    waker.retire();
    future.cancel();
    Err(error)
}

// Two independently scheduled roots; no type erasure, public trait objects,
// suspended references, or requirement that their output types match.
/// Drives two independently scheduled borrowed futures with alternating poll order. Returns both outputs, or cancels unfinished children on failure or budget exhaustion.
export fn join_with_budget<A:Future, B:Future, R:Reactor>(left:&mut A, right:&mut B, reactor:&mut R, turns:u32) -> Result<(A::Output, B::Output), RunError> {
    let queue=match task_set(2, reactor.now()) { Ok(q)=>q, Err(_)=>{ left.cancel(); right.cancel(); return Err(TaskCapacity); } };
    let a=match queue.allocate() { Ok(w)=>w, Err(_)=>{ left.cancel(); right.cancel(); return Err(TaskCapacity); } };
    let b=match queue.allocate() { Ok(w)=>w, Err(_)=>{ a.retire(); left.cancel(); right.cancel(); return Err(TaskCapacity); } };
    let mut first:Option<A::Output> = None;
    let mut second:Option<B::Output> = None;
    let mut reverse=false;
    let mut used:u32=0;
    let mut error=TurnBudgetExceeded;
    while (used < turns) {
        used += 1;
        if (!reactor.turn(queue.wait_hint())) { error=ReactorStopped; break; }
        let now=reactor.now();
        if (!queue.tick(now)) { error=InvalidClock; break; }
        if (reverse) {
            second=step(right, b, now, move(second));
            first=step(left, a, now, move(first));
        } else {
            first=step(left, a, now, move(first));
            second=step(right, b, now, move(second));
        }
        reverse = !reverse;
        let complete={ match &first { Some(_)=>match &second { Some(_)=>true, None=>false }, None=>false } };
        if (complete) {
            match move(first) {
                Some(x)=>match move(second) { Some(y)=>{ return Ok((move(x), move(y))); }, None=>{} },
                None=>{},
            }
            // The readiness check proves these branches unreachable. Keep the
            // ownership state explicit even without path-sensitive refinement.
            first=None; second=None;
        }
    }
    a.retire(); b.retire();
    match &first { None=>left.cancel(), Some(_)=>{} }
    match &second { None=>right.cancel(), Some(_)=>{} }
    Err(error)
}
fn step<F:Future>(future:&mut F, waker:Waker, now:u32, result:Option<F::Output>) -> Option<F::Output> {
    match move(result) { Some(value)=>{ return Some(move(value)); }, None=>{} }
    if (!waker.take_ready()) { return None; }
    let mut cx=Context { waker:waker, now:now };
    match future.poll(&mut cx) {
        Ready(value)=>{ waker.retire(); Some(move(value)) },
        Pending=>None,
    }
}
