/// A persistent singly linked list: `Nil` is empty and `Cons(value, rest)` holds a head and tail.
export type List<T> =
    /// An empty list.
    | Nil
    /// A head value followed by the remaining list.
    | Cons(T, List<T>);

impl<T> List<T> {
    /// Builds a list from a vector, preserving element order.
    export fn from(items: Vec<T>) -> List<T> {
        if (items.is_empty()) {
            Nil
        } else {
            let mut i = items.len() - 1;
            let mut acc = Cons(items[i], Nil);
            while (i > 0) {
                i = i - 1;
                acc = Cons(items[i], acc);
            }
            acc
        }
    }

    /// Returns whether this list is `Nil`.
    export fn is_empty(self) -> bool {
        match self {
            Nil => true,
            Cons(_, _) => false,
        }
    }

    /// Counts the elements recursively; takes linear time in the list length.
    export fn len(self) -> usize {
        match self {
            Nil => 0,
            Cons(_, rest) => {
                let n = rest.len();
                n + 1
            },
        }
    }

    /// Returns the first element, or `None` for an empty list.
    export fn head(self) -> Option<T> {
        match self {
            Nil => None,
            Cons(x, _) => Some(x),
        }
    }

    /// Returns the list without its first element; the tail of `Nil` is `Nil`.
    export fn tail(self) -> List<T> {
        match self {
            Nil => Nil,
            Cons(_, rest) => rest,
        }
    }

    /// Returns the element at a zero-based index, or `None` if it is out of bounds.
    export fn nth(self, index: usize) -> Option<T> {
        match self {
            Nil => None,
            Cons(x, rest) => if (index == 0) { Some(x) } else { rest.nth(index - 1) },
        }
    }

    /// Returns the last element, or `None` for an empty list.
    export fn last(self) -> Option<T> {
        match self {
            Nil => None,
            Cons(x, rest) => if (rest.is_empty()) { Some(x) } else { rest.last() },
        }
    }

    /// Appends `other`, preserving order and rebuilding the left list's spine.
    export fn append(self, other: List<T>) -> List<T> {
        match self {
            Nil => other,
            Cons(x, rest) => Cons(x, rest.append(other)),
        }
    }

    /// Reverses the element order into a new list.
    export fn reverse(self) -> List<T> {
        self.reversed(Nil)
    }

    fn reversed(self, acc: List<T>) -> List<T> {
        match self {
            Nil => acc,
            Cons(x, rest) => rest.reversed(Cons(x, acc)),
        }
    }

    /// Transforms every element with `f`, preserving order.
    export fn map<U>(self, f: fn(T) -> U) -> List<U> {
        match self {
            Nil => Nil,
            Cons(x, rest) => Cons(f(x), rest.map(f)),
        }
    }

    /// Keeps elements for which `predicate` returns true, preserving order.
    export fn filter(self, predicate: fn(T) -> bool) -> List<T> {
        match self {
            Nil => Nil,
            Cons(x, rest) => {
                let tail = rest.filter(predicate);
                if (predicate(x)) { Cons(x, tail) } else { tail }
            },
        }
    }

    /// Combines elements from left to right, starting with `initial`.
    export fn fold<U>(self, initial: U, f: fn(U, T) -> U) -> U {
        match self {
            Nil => initial,
            Cons(x, rest) => rest.fold(f(initial, x), f),
        }
    }

    /// Returns the first element satisfying `predicate`, or `None`.
    export fn find(self, predicate: fn(T) -> bool) -> Option<T> {
        match self {
            Nil => None,
            Cons(x, rest) => if (predicate(x)) { Some(x) } else { rest.find(predicate) },
        }
    }

    /// Returns whether at least one element satisfies `predicate`; stops at the first match.
    export fn any(self, predicate: fn(T) -> bool) -> bool {
        match self {
            Nil => false,
            Cons(x, rest) => if (predicate(x)) { true } else { rest.any(predicate) },
        }
    }

    /// Returns whether every element satisfies `predicate`; an empty list returns true.
    export fn all(self, predicate: fn(T) -> bool) -> bool {
        match self {
            Nil => true,
            Cons(x, rest) => if (predicate(x)) { rest.all(predicate) } else { false },
        }
    }
}
