extern "C" {
    fn getchar() -> c_int;
    fn putchar(ch: c_int) -> c_int;
}

/// Reads one byte from standard input. Returns the C `getchar` result, including a negative value at end of input or on failure.
export fn read_byte() -> c_int { getchar() }

/// Writes one byte to standard output and returns the C `putchar` result.
export fn write_byte(value: c_int) -> c_int { putchar(value) }

/// Writes the indexed bytes of `text` to standard output without adding a newline.
export fn write_text(text: String) -> () {
    let mut i: usize = 0;
    while (i < text.len()) {
        putchar(text[i] as c_int);
        i = i + 1;
    }
}

// Formatting is ordinary, statically dispatched RFL code. __write_value is the
// compiler's scalar/text formatting leaf; it never calls print or println.
/// Values that can write their representation to standard output through static dispatch.
export trait Printable {
    /// Writes this value to standard output without an automatic newline.
    fn print(&self);
}

/// Writes a value's `Printable` representation without adding a newline.
export fn print<T: Printable>(value: T) -> unit { value.print(); }
/// Writes a value's `Printable` representation followed by a newline.
export fn println<T: Printable>(value: T) -> unit {
    value.print();
    putc('\n');
}

impl Printable for i8 { fn print(&self) { __write_value(*self); } }
impl Printable for u8 { fn print(&self) { __write_value(*self); } }
impl Printable for i16 { fn print(&self) { __write_value(*self); } }
impl Printable for u16 { fn print(&self) { __write_value(*self); } }
impl Printable for i32 { fn print(&self) { __write_value(*self); } }
impl Printable for u32 { fn print(&self) { __write_value(*self); } }
impl Printable for i64 { fn print(&self) { __write_value(*self); } }
impl Printable for u64 { fn print(&self) { __write_value(*self); } }
impl Printable for usize { fn print(&self) { __write_value(*self); } }
impl Printable for bool { fn print(&self) { __write_value(*self); } }
impl Printable for char { fn print(&self) { __write_value(*self); } }
impl Printable for String { fn print(&self) { __write_value(*self); } }
impl Printable for f32 { fn print(&self) { __write_value(*self); } }
impl Printable for f64 { fn print(&self) { __write_value(*self); } }

impl<T: Printable> Printable for Vec<T> {
    fn print(&self) {
        __write_value("[");
        let mut i: usize = 0;
        while (i < self.len()) {
            if (i > 0) { __write_value(", "); }
            self[i].print();
            i += 1;
        }
        __write_value("]");
    }
}

impl<T: Printable> Printable for Option<T> {
    fn print(&self) {
        match self {
            None => __write_value("None"),
            Some(value) => { __write_value("Some("); value.print(); __write_value(")"); }
        }
    }
}

impl<T: Printable, E: Printable> Printable for Result<T, E> {
    fn print(&self) {
        match self {
            Ok(value) => { __write_value("Ok("); value.print(); __write_value(")"); },
            Err(error) => { __write_value("Err("); error.print(); __write_value(")"); }
        }
    }
}
