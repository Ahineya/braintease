// Machine-word integers and software f64. Trigonometric functions reduce to
// [-pi/4, pi/4] before evaluating Taylor polynomials (absolute error < 2e-10).
// Ordinary angles use split pi/2; large finite angles use integer range reduction.
// Non-finite angles return NaN. floor and correctly rounded sqrt use integer helpers.

extern "C" {
    fn __rcc_f64_floor(x: f64) -> f64;
    fn __rcc_f64_sqrt(x: f64) -> f64;
    fn __rcc_f64_reduce_pi2(x: f64, quadrant: *mut i32) -> f64;
}

export fn abs(n: i16) -> i16 {
    if (n < 0) { -n } else { n }
}

export fn signum(n: i16) -> i16 {
    if (n < 0) { -1 } else if (n > 0) { 1 } else { 0 }
}

export fn min<T>(a: T, b: T) -> T {
    if (a < b) { a } else { b }
}

export fn max<T>(a: T, b: T) -> T {
    if (a > b) { a } else { b }
}

export fn clamp<T>(n: T, low: T, high: T) -> T {
    if (n < low) { low } else if (n > high) { high } else { n }
}

export fn gcd(a: i16, b: i16) -> i16 {
    let mut x = abs(a);
    let mut y = abs(b);
    while (y != 0) {
        let next = x % y;
        x = y;
        y = next;
    }
    x
}

export fn lcm(a: i16, b: i16) -> i16 {
    if (a == 0 || b == 0) { 0 } else { abs(a) / gcd(a, b) * abs(b) }
}

export fn isqrt(n: i16) -> i16 {
    if (n <= 0) { return 0; }
    let mut guess = n;
    let mut i = 0;
    while (i < 8) {
        guess = (guess + n / guess) / 2;
        i = i + 1;
    }
    if (guess * guess > n) { guess - 1 } else { guess }
}

export fn pow(base: i16, exp: i16) -> i16 {
    if (exp < 0) { return 0; }
    let mut result = 1;
    let mut i = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    result
}

export fn count_ones(n: u16) -> u16 {
    let mut left = n;
    let mut count: u16 = 0;
    while (left != 0) {
        if ((left & 1) == 1) { count = count + 1; }
        left = left >> 1;
    }
    count
}

export const PI: f64 = 3.141592653589793;
export const HALF_PI: f64 = 1.5707963267948966;
export const E: f64 = 2.718281828459045;

export fn fabs(x: f64) -> f64 {
    if (x == 0.0) { 0.0 } else if (x < 0.0) { -x } else { x }
}

export fn floor(x: f64) -> f64 {
    __rcc_f64_floor(x)
}

export fn ceil(x: f64) -> f64 {
    let down = floor(x);
    if (down == x) { return x; }
    let up = down + 1.0;
    if (up == 0.0 && x < 0.0) { -0.0 } else { up }
}

export fn round(x: f64) -> f64 {
    if (x == 0.0 || !finite(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0) { return x; }
    if (x >= 0.0) {
        let down = floor(x);
        if (x - down >= 0.5) { down + 1.0 } else { down }
    } else {
        let up = ceil(x);
        if (up - x >= 0.5) { up - 1.0 } else { up }
    }
}

export fn fract(x: f64) -> f64 {
    x - floor(x)
}

export fn sqrt(x: f64) -> f64 {
    __rcc_f64_sqrt(x)
}

fn finite(x: f64) -> bool {
    x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308
}

fn reduce_pi2(x: f64, quadrant: *mut i32) -> f64 {
    if (x > -1048576.0 && x < 1048576.0) {
        // Multiplication replaces a software division. The high part has only
        // 33 significant bits, so q*high is exact throughout this fast path.
        let q = (x * 0.6366197723675814 + if (x >= 0.0) { 0.5 } else { -0.5 }) as i32;
        unsafe { *quadrant = q & 3; }
        let whole = q as f64;
        (x - whole * 1.5707963267341256) - whole * 6.077100506506192e-11
    } else {
        unsafe { __rcc_f64_reduce_pi2(x, quadrant) * HALF_PI }
    }
}

fn sin_poly(z: f64) -> f64 {
    if (z == 0.0) { return z; }
    let z2 = z * z;
    let mut acc = 2.505210838544172e-8;
    acc = 2.7557319223985893e-6 - z2 * acc;
    acc = 0.0001984126984126984 - z2 * acc;
    acc = 0.008333333333333333 - z2 * acc;
    acc = 0.16666666666666666 - z2 * acc;
    z - (z * z2) * acc
}

fn cos_poly(z: f64) -> f64 {
    let z2 = z * z;
    let mut acc = 2.755731922398589e-7;
    acc = 2.48015873015873e-5 - z2 * acc;
    acc = 0.001388888888888889 - z2 * acc;
    acc = 0.041666666666666664 - z2 * acc;
    acc = 0.5 - z2 * acc;
    1.0 - z2 * acc
}

export fn sin(x: f64) -> f64 {
    if (!finite(x)) { return 0.0 / 0.0; }
    if (x >= -0.7853981633974483 && x <= 0.7853981633974483) { return sin_poly(x); }
    let mut turn: i32 = 0;
    let z = unsafe { reduce_pi2(x, &mut turn) };
    if (turn == 0) { sin_poly(z) }
    else if (turn == 1) { cos_poly(z) }
    else if (turn == 2) { -sin_poly(z) }
    else { -cos_poly(z) }
}

export fn cos(x: f64) -> f64 {
    if (!finite(x)) { return 0.0 / 0.0; }
    if (x >= -0.7853981633974483 && x <= 0.7853981633974483) { return cos_poly(x); }
    let mut turn: i32 = 0;
    let z = unsafe { reduce_pi2(x, &mut turn) };
    if (turn == 0) { cos_poly(z) }
    else if (turn == 1) { -sin_poly(z) }
    else if (turn == 2) { -cos_poly(z) }
    else { sin_poly(z) }
}

export fn tan(x: f64) -> f64 {
    sin(x) / cos(x)
}
