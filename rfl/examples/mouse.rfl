import { start, MOUSE_HOVER, CLOSED, RESIZE, REVERSE, NORMAL } from "std/curses";
import { Rect, number } from "lib/tui";

/// Mouse widget probe: hover/click a button, scroll a counter, Shift-drag to
/// select terminal text. Keyboard Space increments too; q/Esc exits.
fn main() -> i16 {
    let screen = match start() {
        Ok(screen) => move(screen),
        Err(_) => {
            return 1;
        }
    };
    screen.mouse(MOUSE_HOVER);
    let mut count: usize = 0;
    let mut hover = false;
    let mut dirty = true;
    while (true) {
        let button = Rect { row: 3, column: 3, rows: 3, columns: 20 };
        if (dirty) {
            screen.clear();
            screen.text(0, 1, "RFL mouse widgets", NORMAL);
            screen.border(3, 3, 3, 20, if (hover) {
                REVERSE
            } else {
                NORMAL
            });
            screen.text(4, 5, "Click / Space: +1", if (hover) {
                REVERSE
            } else {
                NORMAL
            });
            screen.text(7, 3, "Count: " + number(count), NORMAL);
            screen.text(9, 3, "Wheel changes count. Shift-drag selects terminal text.", NORMAL);
            screen.text(11, 3, "q / Esc: quit", NORMAL);
            screen.refresh();
            dirty = false;
        }
        let event = screen.event();
        let key = event.key();
        if (key == CLOSED || key == 113 || key == 27) {
            return 0;
        }
        if (key == 32) {
            count += 1;
            dirty = true;
        }
        if (key == RESIZE) {
            dirty = true;
        }
        match event.mouse {
            None => {},
            Some(mouse) => {
                let inside = button.contains(mouse.row, mouse.column);
                if (inside && !hover || !inside && hover) {
                    hover = inside;
                    dirty = true;
                }
                if (inside && mouse.pressed() || mouse.wheel() > 0) {
                    count += 1;
                    dirty = true;
                } else if (mouse.wheel() < 0 && count > 0) {
                    count -= 1;
                    dirty = true;
                }
            }
        }
    }
    0
}
