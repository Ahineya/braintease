import { Functor, Monad, map, pure, flat_map, map_monadic } from "std/fp";

type Boxed<T> = Boxed(T);
impl Functor for Boxed {
    fn map<A, B>(value: Self<A>, f: fn(A) -> B) -> Self<B> {
        match move(value) {
            Boxed(a) => Boxed(f(move(a)))
        }
    }
}

impl Monad for Boxed {
    fn pure<A>(value: A) -> Self<A> {
        Boxed(move(value))
    }
    fn flat_map<A, B>(value: Self<A>, f: fn(A) -> Self<B>) -> Self<B> {
        match move(value) {
            Boxed(a) => f(move(a))
        }
    }
}

fn successors(value: i16) -> Vec<i16> {
    [value, value + 1]
}

fn main() {
    println(map(Some(41), fn(x: i16) => x + 1));
    println(map([19, 21], fn(x: i16) => x + 1));
    println(flat_map([1, 3], successors));
    let injected: Option<String> = pure("injected");
    println(injected);
    println(map_monadic([20, 21], fn(x: i16) => x * 2));
    match map(Boxed(41), fn(x: i16) => x + 1) {
        Boxed(value) => println(value)
    };
}
