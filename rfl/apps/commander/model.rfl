import { IoError } from "std/posix";
import { FilePanel, file_panel } from "lib/tui_files";
import { joined as path_joined } from "lib/path";

export struct Browser {
    left: FilePanel,
    right: FilePanel,
    right_active: bool,
    single: bool,
    split: i16,
    status: String
}

export fn joined(directory: String, name: String) -> String {
    path_joined(directory, name)
}

export fn load_panel(path: String) -> Result<FilePanel, IoError> {
    file_panel(path, true)
}

export fn reload(panel: &mut FilePanel) -> Result<unit, IoError> {
    let hidden = panel.show_hidden;
    panel.refresh(hidden)
}

export fn select_name(panel: &mut FilePanel, name: String) {
    panel.select_name(name);
}

export fn select_by(panel: &mut FilePanel, amount: i16, visible: usize) {
    panel.step(amount, visible);
}

export fn keep_visible(panel: &mut FilePanel, visible: usize) {
    panel.reveal(visible);
}

export fn active(state: &Browser) -> FilePanel {
    if (state.right_active) {
        state.right
    } else {
        state.left
    }
}

export fn destination(state: &Browser) -> String {
    if (state.right_active) {
        state.left.path
    } else {
        state.right.path
    }
}

export fn selected_path(state: &Browser) -> String {
    active(state).selected_path()
}

export fn enter(state: &mut Browser, path: String) -> Result<unit, IoError> {
    let panel = load_panel(path)?;
    if (state.right_active) {
        state.right = panel;
    } else {
        state.left = panel;
    }
    Ok({})
}
