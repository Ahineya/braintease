import { Screen, HLINE } from "std/curses";
import { DIRECTORY, SYMLINK } from "std/posix";
import { Browser, Panel, selected_path } from "./model";
import { Theme } from "./theme";
import { number, fitted } from "./format";

export fn visible_rows(screen: &Screen) -> usize {
    if (screen.rows() < 10) {
        1
    } else {
        (screen.rows() - 8) as usize
    }
}

fn panel(screen: &Screen, theme: &Theme, data: Panel, x: i16, width: i16, focused: bool) {
    let bottom = screen.rows() - 4;
    let rows = visible_rows(screen);
    screen.border(1, x, bottom, width, if (focused) {
        theme.title
    } else {
        theme.frame
    });
    let title = if (focused) {
        "[ " + data.path + " ]"
    } else {
        "  " + data.path + "  "
    };
    screen.text(1, x + 2, fitted(title, width - 4), if (focused) {
        theme.title
    } else {
        theme.frame
    });
    screen.text(2, x + 2, "Name", theme.muted);
    screen.text(2, x + width - 10, "Size", theme.muted);
    if (theme.lines) {
        for (column in 1..(width - 1) as usize) {
            screen.glyph(3, x + column as i16, HLINE, theme.frame);
        }
    } else {
        screen.fill(3, x + 1, width - 2, '-', theme.frame);
    }
    for (row in 0..rows) {
        let y = row as i16 + 4;
        let i = data.top + row;
        if (i < data.entries.len()) {
            let entry = data.entries[i];
            let selected = i == data.selected;
            let style = if (selected) {
                if (focused) {
                    theme.selected
                } else {
                    theme.inactive
                }
            } else if (entry.info.kind == DIRECTORY) {
                theme.directory
            } else {
                theme.text
            };
            screen.fill(y, x + 1, width - 3, ' ', style);
            let mark = if (selected) {
                ">"
            } else if (entry.info.kind == DIRECTORY) {
                "/"
            } else if (entry.info.kind == SYMLINK) {
                "@"
            } else {
                " "
            };
            screen.text(y, x + 1, mark + fitted(entry.name, width - 14), style);
            let size = if (entry.info.kind == DIRECTORY) {
                "<DIR>"
            } else {
                number(entry.info.size)
            };
            screen.text(y, x + width - 12, fitted(size, 9), style);
        }
    }
    if (data.entries.len() > rows) {
        let thumb = (data.selected * (rows - 1) / (data.entries.len() - 1)) as i16;
        for (row in 0..rows) {
            screen.text(row as i16 + 4, x + width - 2, if (row as i16 == thumb) {
                "#"
            } else {
                ":"
            }, theme.muted);
        }
    }
    let count = number((data.selected + 1) as u32) + "/" + number(data.entries.len() as u32);
    screen.text(bottom, x + width - count.len() as i16 - 3, count, theme.frame);
}

export fn render(screen: &Screen, theme: &Theme, state: &Browser) {
    screen.background(theme.text);
    let width = screen.columns();
    let height = screen.rows();
    if (width < 40 || height < 10) {
        screen.text(0, 0, "RFL Commander: terminal needs 40x10", theme.error);
        screen.text(1, 0, "Resize terminal, or q/F10 to quit", theme.text);
        screen.refresh();
        return;
    }
    screen.fill(0, 0, width, ' ', theme.status);
    screen.text(0, 1, "RFL Commander", theme.accent);
    screen.text(0, 16, fitted("^A About  ^O Shell  ^P Layout  r Rename | " + theme.name, width - 17), theme.status);
    if (state.single) {
        panel(screen, theme, if (state.right_active) {
            state.right
        } else {
            state.left
        }, 0, width, true);
    } else {
        let half = width / 2;
        panel(screen, theme, state.left, 0, half, !state.right_active);
        panel(screen, theme, state.right, half, width - half, state.right_active);
    }
    screen.fill(height - 3, 0, width, ' ', theme.status);
    screen.text(height - 3, 1, fitted(state.status, width - 2), theme.status);
    screen.text(height - 2, 1, fitted("Selected: " + selected_path(state), width - 2), theme.muted);
    screen.fill(height - 1, 0, width, ' ', theme.status);
    let labels = ["2 Load", "3 View", "4 Edit", "5 Copy", "6 Move", "7 Mkdir", "8 Del", "9 Theme", "10 Quit"];
    let slot = width / labels.len() as i16;
    for (i in 0..labels.len()) {
        screen.text(height - 1, i as i16 * slot, fitted(labels[i], slot - 1), theme.accent);
    }
    screen.cursor(height - 2, 0, false);
    screen.refresh();
}
