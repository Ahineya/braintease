import { prompt as input_prompt, choose as choice_dialog, message as message_dialog, Palette } from "lib/tui_dialog";
import { Screen, Window, TerminalError, InvalidWindow, BOLD, BACKSPACE, CLOSED, RESIZE, NO_KEY, UP, DOWN, HOME, END, PAGE_UP, PAGE_DOWN, LEFT, RIGHT } from "std/curses";
import { open_read, IoError, read_bytes as read, write_text, STDIN, STDOUT, run_command, run_program, change_directory, metadata, read_dir, REGULAR, UnsupportedFileType, Errno } from "std/posix";
import { Rect } from "lib/tui";
import { buffer } from "lib/text";
import { ends_with } from "std/string";
import { Theme } from "./theme";
import { fitted, number } from "./format";

struct Popup {
    window: Window,
    shadow: Window,
    area: Rect
}

fn popup(screen: &Screen, theme: &Theme, title: String, height: i16) -> Result<Popup, TerminalError> {
    if (screen.rows() < 8 || screen.columns() < 20) {
        return Err(InvalidWindow);
    }
    let width = if (screen.columns() > 80) {
        76
    } else {
        screen.columns() - 4
    };
    let height = if (height < 6) {
        6
    } else {
        height
    };
    let height = if (height > screen.rows() - 2) {
        screen.rows() - 2
    } else {
        height
    };
    let row = (screen.rows() - height) / 2;
    let column = (screen.columns() - width) / 2;
    let shadow = screen.window(height, width, row + 1, column + 2)?;
    let window = screen.window(height, width, row, column)?;
    shadow.background(theme.shadow);
    window.background(theme.dialog);
    window.border(theme.dialog);
    window.text(0, 2, fitted(" " + title + " ", width - 4), theme.dialog | BOLD);
    Ok(Popup { window: move(window), shadow: move(shadow), area: Rect { row: row, column: column, rows: height, columns: width } })
}

fn present(screen: &Screen, panel: &Popup) {
    screen.stage();
    panel.shadow.stage();
    panel.window.stage();
    screen.present();
}

export fn prompt(screen: &Screen, theme: &Theme, title: String, initial: String) -> Option<String> {
    input_prompt(screen, Palette { body: theme.dialog, title: theme.dialog | BOLD, input: theme.input, selected: theme.selected, shadow: theme.shadow }, title, initial)
}

fn palette(theme: &Theme) -> Palette {
    Palette { body: theme.dialog, title: theme.dialog | BOLD, input: theme.input, selected: theme.selected, shadow: theme.shadow }
}

export fn confirm(screen: &Screen, theme: &Theme, question: String) -> bool {
    while (true) {
        let panel = match popup(screen, theme, "Confirm", 7) {
            Ok(panel) => move(panel),
            Err(_) => {
                return false;
            }
        };
        panel.window.text(2, 2, fitted(question + " [y/N]", panel.window.columns() - 4), theme.dialog);
        panel.window.text(4, 2, "y: confirm   n / Esc: cancel", theme.dialog | BOLD);
        panel.window.cursor(0, 0, false);
        present(screen, &panel);
        while (true) {
            let event = panel.window.event();
            let mut key = event.key();
            match event.mouse {
                Some(pointer) => {
                    if (pointer.pressed() && panel.area.contains(pointer.row, pointer.column) && pointer.row == panel.area.row + 4) {
                        key = if (pointer.column - panel.area.column < 14) {
                            121
                        } else {
                            110
                        };
                    }
                },
                None => {}
            }
            if (key == 121 || key == 89) {
                return true;
            }
            if (key == 27 || key == 3 || key == 110 || key == 78 || key == 10 || key == 13 || key == CLOSED) {
                return false;
            }
            if (key == RESIZE) {
                break;
            }
        }
    }
    false
}

export fn choose(screen: &Screen, theme: &Theme) -> Option<String> {
    let mut names = ["configured"];
    match read_dir("/usr/share/mc/themes") {
        Ok(entries) => {
            for (i in 0..entries.len()) {
                let name = entries[i].name;
                if (entries[i].info.kind == REGULAR && ends_with(name, ".ini")) {
                    names.push(name[0..name.len() - 4]);
                }
            }
        },
        Err(_) => {},
    }
    match choice_dialog(screen, palette(theme), "Choose theme (session only)", names, 0) {
        Some(index) => Some(names[index]),
        None => None
    }
}

export fn view(screen: &Screen, theme: &Theme, path: String) -> Result<unit, IoError> {
    let info = metadata(path)?;
    if (info.kind != REGULAR) {
        return Err(UnsupportedFileType);
    }
    let file = open_read(path)?;
    let bytes = file.read(16384)?;
    let text = match buffer() {
        Ok(text) => move(text),
        Err(_) => {
            return Err(Errno(12));
        }
    };
    if (text.append(bytes).is_err()) {
        return Err(UnsupportedFileType);
    }
    let styles = [theme.dialog, theme.dialog, theme.dialog, theme.dialog, theme.dialog, theme.dialog, theme.dialog];
    let mut top: usize = 0;
    let mut left: usize = 0;
    let mut wrap = true;
    let mut anchor: usize = 0;
    while (true) {
        let panel = match popup(screen, theme, "View: " + path, screen.rows() - 4) {
            Ok(panel) => move(panel),
            Err(_) => {
                return Ok({});
            }
        };
        let width = (panel.window.columns() - 4) as u16;
        let height = (panel.window.rows() - 4) as usize;
        let mut changed = true;
        while (true) {
            let count = if (wrap) {
                text.wrap_at(text.len(), width, 4) + 1
            } else {
                text.lines()
            };
            let last = if (count > height) {
                count - height
            } else {
                0 as usize
            };
            if (changed) {
                top = if (wrap) {
                    text.wrap_at(anchor, width, 4)
                } else {
                    text.row(anchor)
                };
                if (top > last) {
                    top = last;
                }
            }
            for (row in 0..height) {
                panel.window.fill(row as i16 + 1, 1, panel.window.columns() - 2, ' ', theme.dialog);
                if (top + row < count) {
                    let info = text.wrapped(if (wrap) {
                        top + row
                    } else {
                        0 as usize
                    }, width, 4);
                    let logical = if (wrap) {
                        info.row
                    } else {
                        top + row
                    };
                    let column = if (wrap) {
                        info.left
                    } else {
                        left
                    };
                    let size = if (wrap && info.columns < width) {
                        info.columns
                    } else {
                        width
                    };
                    match text.cells(logical, column, size, 4, styles, theme.dialog, 0, 0) {
                        Ok(cells) => {
                            panel.window.cells(row as i16 + 1, 2, cells);
                        },
                        Err(_) => {
                            return Err(Errno(12));
                        }
                    }
                }
            }
            let label = if (wrap) {
                "Wrap:on [w]"
            } else {
                "Wrap:off [w] Left/Right"
            };
            panel.window.fill(panel.window.rows() - 2, 1, panel.window.columns() - 2, ' ', theme.dialog);
            panel.window.text(panel.window.rows() - 2, 2, fitted(label + " | PgUp/PgDn | q/Esc close | First 16 KiB", panel.window.columns() - 4), theme.dialog | BOLD);
            panel.window.cursor(0, 0, false);
            present(screen, &panel);
            changed = false;
            let event = panel.window.event();
            let mut key = event.key();
            match event.mouse {
                Some(pointer) => {
                    if (panel.area.contains(pointer.row, pointer.column)) {
                        if (pointer.wheel() < 0) {
                            key = UP;
                        } else if (pointer.wheel() > 0) {
                            key = DOWN;
                        } else if (pointer.pressed() && pointer.row == panel.area.row + panel.area.rows - 2) {
                            key = 27;
                        }
                    }
                },
                None => {}
            }
            if (key == NO_KEY) {
                continue;
            }
            if (key == 113 || key == 27 || key == 3 || key == CLOSED) {
                return Ok({});
            }
            anchor = if (wrap) {
                text.wrapped(top, width, 4).start
            } else {
                text.column(top, left, 4)
            };
            if (key == RESIZE) {
                break;
            }
            if (key == 119 || key == 87) {
                if (wrap) {
                    left = text.wrapped(top, width, 4).left;
                }
                wrap = !wrap;
                changed = true;
            } else if (key == UP || key == PAGE_UP) {
                let distance = if (key == UP) {
                    1 as usize
                } else {
                    height
                };
                top = if (top > distance) {
                    top - distance
                } else {
                    0 as usize
                };
            } else if (key == DOWN || key == PAGE_DOWN) {
                let distance = if (key == DOWN) {
                    1 as usize
                } else {
                    height
                };
                top = if (top + distance < last) {
                    top + distance
                } else {
                    last
                };
            } else if (key == HOME) {
                top = 0;
                left = 0;
            } else if (key == END) {
                top = last;
            } else if (!wrap && key == LEFT) {
                left = if (left > 4) {
                    left - 4
                } else {
                    0 as usize
                };
            } else if (!wrap && key == RIGHT) {
                let mut maximum: usize = 0;
                for (row in 0..height) {
                    if (top + row < text.lines()) {
                        let columns = text.visual(text.endline(top + row), 4);
                        if (columns > width as usize && columns - width as usize > maximum) {
                            maximum = columns - width as usize;
                        }
                    }
                }
                left = if (left + 4 < maximum) {
                    left + 4
                } else {
                    maximum
                };
            }
        }
    }
    Ok({})
}

// Let the guest shell own editing, completion, history and job control.
// Browser state survives suspend/resume; exit or Ctrl-D returns to the panels.
export fn console(screen: &Screen, path: String) -> Result<unit, IoError> {
    change_directory(path)?;
    screen.clear();
    screen.refresh();
    screen.suspend();
    write_text(STDOUT, "RFL Commander shell (exit or Ctrl-D returns to panels)\n")?;
    run_program("/bin/sh", ["-i"])?;
    Ok({})
}

export fn about(screen: &Screen, theme: &Theme) {
    let lines = ["RFL Commander", "A two-panel file manager written in RFL.", "For Riplix and Fuse-X; shared C16 curses.", "", "Enter: open directory / run program / view", "F3 View  F4 Edit  F5 Copy  F6 Move  r Rename", "F7 Mkdir  F8 Delete  F9 Theme  F10 Quit", "Tab: panel  Ctrl-O: shell  Ctrl-P: layout", "s: SFTP connections (uses ~/.ssh/config profiles)"];
    message_dialog(screen, palette(theme), "About RFL Commander", lines);
}

// Returns with curses suspended; the controller resumes even on command/error.
export fn external(screen: &Screen, directory: String, command: String, pause: bool) -> Result<i32, IoError> {
    change_directory(directory)?;
    screen.suspend();
    let result = if (pause) {
        run_program(command, [])
    } else {
        run_command(command)
    };
    if (pause) {
        write_text(STDOUT, "\nPress Enter to return to Commander...")?;
        read(STDIN, 1024)?;
    }
    result
}

export fn connection_choice(screen: &Screen, theme: &Theme, title: String, choices: Vec<String>) -> Option<usize> {
    choice_dialog(screen, palette(theme), title, choices, 0)
}
