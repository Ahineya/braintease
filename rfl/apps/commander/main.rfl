import { start, Screen, RESIZE, NO_KEY, CLOSED, MOUSE_DRAG, function_key } from "std/curses";
import { IoError, arguments, working_directory, metadata, executable, DIRECTORY, create_dir, error_message, Errno, run_program, change_directory } from "std/posix";
import { Browser, active, destination, selected_path, joined, load_panel, enter, reload, select_by, select_name, keep_visible } from "./model";
import { action, Navigate, First, Last, Enter, Parent, Switch, Reload, Copy, Move, Mkdir, Delete, View, Quit, Console, SinglePanel, NoAction, ThemeMenu, About, Edit, Rename, Network } from "./keys";
import { default_theme, choose_theme, Theme } from "./theme";
import { render, render_cached, painting, visible_rows, panel_area } from "./ui";
import { number } from "./format";
import { prompt, confirm, view, console, choose, about, external, connection_choice } from "./widgets";
import { copy_file, move_path, delete_path, Moved, CopiedSourceRetained, editor_command } from "./actions";
import { parent } from "lib/path";
import { connections, unmount } from "std/sftp";

fn refresh(state: &mut Browser) {
    let mut shared = false;
    match reload(&mut state.left) {
        Ok(_) => {
            if (state.left.path == state.right.path) {
                let snapshot = state.left;
                state.right.share_listing(&snapshot);
                shared = true;
            }
        },
        Err(error) => {
            state.status = error_message(error);
        }
    }
    if (shared) {
        return;
    }
    match reload(&mut state.right) {
        Ok(_) => {},
        Err(error) => {
            state.status = error_message(error);
        }
    }
}

fn inside(path: String, directory: String) -> bool {
    path == directory || path.len() > directory.len() && path[0..directory.len()] == directory && path[directory.len()] == '/'
}

fn refresh_affected(state: &mut Browser, source: String, target: String) {
    let from = parent(source);
    let to = parent(target);
    let mut shared = false;
    if (state.left.path == from || state.left.path == to || inside(state.left.path, source) || inside(state.left.path, target)) {
        match reload(&mut state.left) {
            Ok(_) => {
                if (state.left.path == state.right.path) {
                    let snapshot = state.left;
                    state.right.share_listing(&snapshot);
                    shared = true;
                }
            },
            Err(error) => {
                state.status = error_message(error);
            }
        }
    }
    if (!shared && (state.right.path == from || state.right.path == to || inside(state.right.path, source) || inside(state.right.path, target))) {
        match reload(&mut state.right) {
            Ok(_) => {},
            Err(error) => {
                state.status = error_message(error);
            }
        }
    }
}

fn operation(screen: &Screen, theme: &Theme, state: &mut Browser, copy: bool) -> Result<unit, IoError> {
    let panel = active(&*state);
    let entry = panel.entries[panel.cursor.selected];
    if (entry.name == "..") {
        state.status = "Select a file or directory first";
        return Ok({});
    }
    let target = joined(destination(&*state), entry.name);
    match prompt(screen, theme, if (copy) {
        "Copy to"
    } else {
        "Move to"
    }, target) {
        None => {},
        Some(path) => {
            let target = joined(panel.path, path);
            let exists = match metadata(target) {
                Ok(_) => true,
                Err(_) => false
            };
            if (exists && !confirm(screen, theme, "Overwrite " + target + "?")) {
                return Ok({});
            }
            state.status = if (copy) {
                "Copying..."
            } else {
                "Moving..."
            };
            render(screen, theme, &*state);
            if (copy) {
                let bytes = copy_file(selected_path(&*state), target)?;
                state.status = "Copied " + number(bytes) + " bytes";
            } else {
                match move_path(selected_path(&*state), target)? {
                    Moved => {
                        state.status = "Moved successfully";
                    },
                    CopiedSourceRetained(error) => {
                        state.status = "Copied; source kept: " + error_message(error);
                    }
                }
            }
            let original = selected_path(&*state);
            refresh_affected(state, original, target);
        },
    }
    Ok({})
}

fn rename_selected(screen: &Screen, theme: &Theme, state: &mut Browser) -> Result<unit, IoError> {
    let panel = active(&*state);
    let entry = panel.entries[panel.cursor.selected];
    if (entry.name == "..") {
        state.status = "Select a file or directory first";
        return Ok({});
    }
    match prompt(screen, theme, "Rename", entry.name) {
        None => {},
        Some(name) => {
            if (name == entry.name) {
                state.status = "Name unchanged";
                return Ok({});
            }
            let mut invalid = name == "" || name == "." || name == "..";
            for (i in 0..name.len()) {
                if (name[i] == '/') {
                    invalid = true;
                }
            }
            if (invalid) {
                state.status = "Enter a filename without / (F6 moves to another path)";
                return Ok({});
            }
            let target = joined(panel.path, name);
            let exists = match metadata(target) {
                Ok(_) => true,
                Err(_) => false
            };
            if (exists && !confirm(screen, theme, "Overwrite " + target + "?")) {
                return Ok({});
            }
            match move_path(selected_path(&*state), target)? {
                Moved => {
                    state.status = "Renamed successfully";
                },
                CopiedSourceRetained(error) => {
                    state.status = "Copied; source kept: " + error_message(error);
                }
            }
            let original = selected_path(&*state);
            refresh_affected(state, original, target);
            if (state.right_active) {
                select_name(&mut state.right, name);
            } else {
                select_name(&mut state.left, name);
            }
        }
    }
    Ok({})
}

fn launch(screen: &Screen, state: &mut Browser, edit: bool) -> bool {
    let panel = active(&*state);
    let path = selected_path(&*state);
    let command = if (edit) {
        editor_command(path)
    } else {
        Ok(path)
    };
    let result = match command {
        Ok(command) => external(screen, panel.path, command, !edit),
        Err(error) => Err(error)
    };
    match screen.resume() {
        Ok(_) => {},
        Err(_) => {
            return false;
        }
    }
    refresh(state);
    state.status = match result {
        Ok(status) => if (status == 0) {
            if (edit) {
                "Returned from editor"
            } else {
                "Program finished"
            }
        } else {
            "Program wait status: " + number(status as u32)
        },
        Err(error) => error_message(error)
    };
    true
}

// The helper authenticates in the foreground so host fingerprints and key
// passphrases use the existing protected SSH prompts. Only its service remains
// in the background; Commander never stores passwords or constructs shell text.
fn network(screen: &Screen, theme: &Theme, state: &mut Browser) -> Result<unit, IoError> {
    let choice = connection_choice(screen, theme, "SFTP connections", ["Connect remote directory", "Disconnect / connection status"]);
    match choice {
        None => {},
        Some(0) => {
            let endpoint = match prompt(screen, theme, "SSH profile or user@host:/directory", "") {
                Some(value) => value,
                None => { return Ok({}); }
            };
            if (endpoint == "") { return Ok({}); }
            let point = match prompt(screen, theme, "Mount directory (empty, under /mnt)", "/mnt/remote") {
                Some(value) => value,
                None => { return Ok({}); }
            };
            if (point.len() < 6 || point[0..5] != "/mnt/") { state.status = "Choose a directory under /mnt"; return Ok({}); }
            match create_dir("/mnt") { Ok(_) => {}, Err(Errno(17)) => {}, Err(error) => { return Err(error); } }
            match create_dir(point) { Ok(_) => {}, Err(Errno(17)) => {}, Err(error) => { return Err(error); } }
            let mut helper = "/bin/sftp-mount";
            match executable(helper) {
                Ok(true) => {},
                _ => { helper = "/mnt/host/ssh/sftp-mount.fxe"; }
            }
            screen.suspend();
            let result = run_program(helper, ["--background", endpoint, point]);
            screen.resume();
            match result {
                Ok(0) => { enter(state, point)?; state.status = "SFTP connected; ordinary copy, edit and move commands work here"; },
                Ok(_) => { state.status = "SFTP connection failed; check the SSH profile, identity and host key"; },
                Err(error) => { return Err(error); }
            }
        },
        Some(_) => {
            let list = connections()?;
            if (list.is_empty()) { state.status = "No SFTP directories mounted"; return Ok({}); }
            let mut labels: Vec<String> = [];
            for (i in 0..list.len()) {
                labels.push(list[i].path + if (list[i].connected) { " (connected)" } else { " (disconnected)" });
            }
            match connection_choice(screen, theme, "Select connection to disconnect", labels) {
                None => {},
                Some(index) => {
                    let connection = list[index];
                    if (confirm(screen, theme, "Disconnect " + connection.path + "?")) {
                        // Panel snapshots own no descriptors. Release a cwd inherited
                        // from Ctrl-O, then let the kernel reject other busy users.
                        change_directory("/")?;
                        unmount(connection.index)?;
                        if (inside(state.left.path, connection.path)) { state.left = load_panel("/mnt")?; }
                        if (inside(state.right.path, connection.path)) { state.right = load_panel("/mnt")?; }
                        state.status = "SFTP disconnected";
                    }
                }
            }
        }
    }
    Ok({})
}

fn run(screen: &Screen, initial_theme: Theme, state: &mut Browser) {
    let mut theme = initial_theme;
    let mut painted = painting();
    let mut dirty = true;
    let mut dragging = false;
    screen.mouse(MOUSE_DRAG);
    while (true) {
        let rows = visible_rows(screen);
        keep_visible(&mut state.left, rows);
        keep_visible(&mut state.right, rows);
        if (dirty) {
            render_cached(screen, &theme, &*state, &mut painted);
            dirty = false;
        }
        let event = screen.event();
        let mut key = event.key();
        if (key == CLOSED) {
            return;
        }
        match event.mouse {
            None => {},
            Some(mouse) => {
                if (screen.columns() < 40 || screen.rows() < 10) {
                    continue;
                }
                let left = panel_area(screen, &*state, false);
                let right = panel_area(screen, &*state, true);
                if (mouse.released()) {
                    dragging = false;
                    continue;
                }
                if (!state.single && mouse.pressed() && mouse.column == right.column && mouse.row >= 1 && mouse.row < screen.rows() - 3) {
                    dragging = true;
                    continue;
                }
                if (dragging && mouse.motion()) {
                    let column = if (mouse.column < 20) {
                        20
                    } else if (mouse.column > screen.columns() - 20) {
                        screen.columns() - 20
                    } else {
                        mouse.column
                    };
                    state.split = ((column as i32 * 100 + screen.columns() as i32 - 1) / screen.columns() as i32) as i16;
                    dirty = true;
                    continue;
                }
                if (mouse.pressed() && mouse.row == screen.rows() - 1) {
                    let slot = screen.columns() / 9;
                    let button = mouse.column / slot;
                    if (button < 9) {
                        key = function_key(button + 2);
                    }
                } else {
                    if (mouse.pressed() || mouse.wheel() != 0) {
                        let prior = state.right_active;
                        if (!state.single && mouse.pressed()) {
                            if (left.contains(mouse.row, mouse.column)) {
                                state.right_active = false;
                            } else if (right.contains(mouse.row, mouse.column)) {
                                state.right_active = true;
                            }
                        }
                        let changed = if (state.single) {
                            if (state.right_active) {
                                state.right.mouse(right, mouse)
                            } else {
                                state.left.mouse(left, mouse)
                            }
                        } else if (right.contains(mouse.row, mouse.column)) {
                            state.right.mouse(right, mouse)
                        } else {
                            state.left.mouse(left, mouse)
                        };
                        dirty = changed || (prior && !state.right_active || !prior && state.right_active);
                    }
                    continue;
                }
            }
        }
        if (key == NO_KEY) {
            continue;
        }
        if (key == RESIZE) {
            dragging = false;
            dirty = true;
            continue;
        }
        dirty = true;
        let command = action(key, rows as i16);
        let quick = match command {
            Navigate(_) => true,
            First => true,
            Last => true,
            Switch => true,
            NoAction => true,
            _ => false
        };
        let prior_left = state.left.cursor.selected;
        let prior_right = state.right.cursor.selected;
        let prior_focus = state.right_active;
        if (!quick) {
            painted.valid = false;
        }
        match command {
            Quit => {
                return;
            },
            Navigate(distance) => {
                if (state.right_active) {
                    select_by(&mut state.right, distance, rows);
                } else {
                    select_by(&mut state.left, distance, rows);
                }
            },
            First => {
                if (state.right_active) {
                    state.right.cursor.selected = 0;
                } else {
                    state.left.cursor.selected = 0;
                }
            },
            Last => {
                if (state.right_active) {
                    state.right.cursor.selected = state.right.entries.len() - 1;
                } else {
                    state.left.cursor.selected = state.left.entries.len() - 1;
                }
            },
            Switch => {
                state.right_active = !state.right_active;
            },
            Reload => {
                refresh(state);
                state.status = "Reloaded";
            },
            Parent => {
                let panel = active(&*state);
                match enter(state, joined(panel.path, "..")) {
                    Ok(_) => {},
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
            },
            Enter => {
                let panel = active(&*state);
                let entry = panel.entries[panel.cursor.selected];
                let path = selected_path(&*state);
                let result = if (entry.info.kind == DIRECTORY) {
                    enter(state, path)
                } else {
                    match executable(path) {
                        Ok(true) => {
                            if (!launch(screen, state, false)) {
                                return;
                            }
                            Ok({})
                        },
                        Ok(false) => view(screen, &theme, path),
                        Err(error) => Err(error)
                    }
                };
                match result {
                    Ok(_) => {},
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
            },
            View => {
                let panel = active(&*state);
                if (panel.entries[panel.cursor.selected].info.kind != DIRECTORY) {
                    match view(screen, &theme, selected_path(&*state)) {
                        Ok(_) => {},
                        Err(error) => {
                            state.status = error_message(error);
                        }
                    }
                }
            },
            About => {
                about(screen, &theme);
            },
            Edit => {
                let panel = active(&*state);
                if (panel.entries[panel.cursor.selected].info.kind != DIRECTORY) {
                    if (!launch(screen, state, true)) {
                        return;
                    }
                }
            },
            Rename => {
                match rename_selected(screen, &theme, state) {
                    Ok(_) => {},
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
            },
            Copy => {
                match operation(screen, &theme, state, true) {
                    Ok(_) => {},
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
            },
            Move => {
                match operation(screen, &theme, state, false) {
                    Ok(_) => {},
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
            },
            Mkdir => {
                match prompt(screen, &theme, "New directory", "") {
                    None => {},
                    Some(name) => {
                        if (name != "") {
                            let panel = active(&*state);
                            match create_dir(joined(panel.path, name)) {
                                Ok(_) => {
                                    state.status = "Directory created";
                                    let path = joined(panel.path, name);
                                    refresh_affected(state, path, path);
                                },
                                Err(error) => {
                                    state.status = error_message(error);
                                },
                            }
                        }
                    },
                }
            },
            Delete => {
                let panel = active(&*state);
                let entry = panel.entries[panel.cursor.selected];
                if (entry.name != ".." && confirm(screen, &theme, "Delete " + entry.name + "?")) {
                    match delete_path(selected_path(&*state)) {
                        Ok(_) => {
                            state.status = "Deleted successfully";
                            let path = selected_path(&*state);
                            refresh_affected(state, path, path);
                        },
                        Err(error) => {
                            state.status = error_message(error);
                        },
                    }
                }
            },
            Console => {
                let panel = active(&*state);
                let result = console(screen, panel.path);
                match screen.resume() {
                    Ok(_) => {},
                    Err(_) => {
                        return;
                    }
                }
                match result {
                    Ok(_) => {
                        state.status = "Returned from guest shell";
                    },
                    Err(error) => {
                        state.status = error_message(error);
                    }
                }
                refresh(state);
            },
            SinglePanel => {
                state.single = !state.single;
            },
            Network => {
                match network(screen, &theme, state) {
                    Ok(_) => {},
                    Err(error) => { state.status = error_message(error); }
                }
            },
            ThemeMenu => {
                match choose(screen, &theme) {
                    None => {},
                    Some(name) => {
                        match choose_theme(screen, name) {
                            Ok(next) => {
                                theme = next;
                                state.status = "Theme: " + theme.name;
                            },
                            Err(error) => {
                                state.status = error;
                            },
                        }
                    },
                }
            },
            NoAction => {},
        }
        if (quick && prior_left == state.left.cursor.selected && prior_right == state.right.cursor.selected && (prior_focus && state.right_active || !prior_focus && !state.right_active)) {
            dirty = false;
        }
    }
}

fn main() -> i16 {
    let cwd = match working_directory() {
        Ok(path) => path,
        Err(error) => {
            println(error_message(error));
            return 1;
        }
    };
    let args = arguments();
    let left_path = if (args.len() > 1) {
        joined(cwd, args[1])
    } else {
        cwd
    };
    let right_path = if (args.len() > 2) {
        joined(cwd, args[2])
    } else {
        cwd
    };
    let left = match load_panel(left_path) {
        Ok(panel) => panel,
        Err(error) => {
            println(error_message(error));
            return 1;
        }
    };
    let right = if (right_path == left.path) {
        left
    } else {
        match load_panel(right_path) {
            Ok(panel) => panel,
            Err(error) => {
                println(error_message(error));
                return 1;
            }
        }
    };
    let mut state = Browser { left: left, right: right, right_active: false, single: false, split: 50, status: "Enter: open/run/view; F4 edit; r rename; Ctrl-A about" };
    let screen = match start() {
        Ok(screen) => move(screen),
        Err(_) => {
            println("Cannot initialize terminal");
            return 1;
        }
    };
    let theme = default_theme(&screen);
    if (theme.notice != "") {
        state.status = theme.notice;
    }
    run(&screen, theme, &mut state);
    0
}
