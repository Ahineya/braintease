import {} from "std/result";
import { start, InputEvent, LEFT, RIGHT, BACKSPACE, CLOSED, BOLD, color_pair } from "std/curses";
import { line_edit } from "lib/tui_input";
import { fitted } from "lib/tui";
import { columns, next, previous } from "lib/unicode";

fn checks() -> bool {
    let text = "AЖé中🙂Z";
    if (columns(text) != 8 || fitted(text, 4) != "AЖé" || next(text, 3) != 6 || previous(text, 6) != 3) { return false; }
    let mut input = line_edit("Жé中🙂");
    input.key(LEFT);
    input.key(BACKSPACE);
    if (input.text != "Жé🙂" || input.cursor != 5) { return false; }
    input.key(LEFT);
    input.key(330);
    if (input.text != "Ж🙂" || input.cursor != 2) { return false; }
    input.event(InputEvent { kind: 0, value: 258, mouse: None });
    if (input.text != "ЖĂ🙂" || input.cursor != 4 || input.column(8) != 2) { return false; }
    input.key(RIGHT);
    input.key(BACKSPACE);
    input.text == "ЖĂ"
}
fn edit() -> String {
    let screen = start().unwrap();
    screen.colors();
    screen.define_pair(1, 7, 4);
    screen.background(color_pair(1));
    screen.text(0, 0, "Unicode: Привет Ελληνικά café é 中 🙂", BOLD | color_pair(1));
    screen.text(1, screen.columns() - 1, "中", 0);
    screen.text(2, 0, "TYPE_UTF8", 0);
    screen.text(5, 3, "Z", 0);
    screen.fill(5, 0, 3, '中', 0);
    if (screen.columns() >= 512) {
        let mut long = "";
        for (i in 0..511) { long = long + "x"; }
        screen.text(3, 0, long + "Ж", 0);
    }
    let mut input = line_edit("");
    while (true) {
        input.draw(&screen, 4, 0, 20, color_pair(1));
        screen.cursor(4, input.column(20) as i16, true);
        screen.refresh();
        let event = screen.event();
        let key = event.key();
        if (key == 13 || key == 10 || key == CLOSED) { return input.text; }
        input.event(event);
    }
    ""
}
fn main() -> i16 {
    if (!checks()) { println("UNICODE_CHECK_FAILED"); return 1; }
    let result = edit();
    println("UNICODE_INPUT:" + result);
    println("UNICODE_TUI_OK");
    0
}
