import {} from "std/result";
import {} from "../../../libraries/unicode/unicode.c";
import { buffer, octets, Buffer } from "lib/text";
import { key, event, selection, controls, view, Vi, View, reset } from "../../apps/rift/vi";
import { InputEvent } from "std/curses";
import { Settings } from "../../apps/rift/config";
import { detect } from "../../apps/rift/languages";
import { joined, parent, basename } from "lib/path";
fn settings() -> Settings {
    Settings { tabstop: 4, expandtab: true, autoindent: true, numbers: true, wrap: true, textwidth: 0, format_text: true, runs: [], notice: "" }
}

fn keys(b: &Buffer, v: &mut View, vi: &mut Vi, input: String) {
    let settings = settings();
    for (i in 0..input.len()) {
        key(b, v, vi, input[i] as i16, &settings, 19);
    }
}

fn equal(b: &Buffer, text: String) -> bool {
    let bytes = b.bytes(0, b.len()).unwrap();
    let expected = octets(text).unwrap();
    if (bytes.len() != expected.len()) {
        return false;
    }
    for (i in 0..bytes.len()) {
        if (bytes[i] != expected[i]) {
            return false;
        }
    }
    true
}

fn object_change() -> bool {
    let b = buffer().unwrap();
    b.append(octets("call(one, nested(two));\nnext\n").unwrap()).unwrap();
    b.language(1);
    b.saved();
    let mut v = view();
    let mut vi = controls();
    keys(&b, &mut v, &mut vi, "f(ci)hello" + from_char(27 as char) + "");
    if (!equal(&b, "call(hello);\nnext\n") || vi.mode != 0) {
        println("ci) failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u");
    if (!equal(&b, "call(one, nested(two));\nnext\n") || b.modified()) {
        println("undo failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "" + from_char(18 as char) + "");
    if (!equal(&b, "call(hello);\nnext\n")) {
        println("redo failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u.");
    if (!equal(&b, "call(hello);\nnext\n")) {
        println("dot failed");
        return false;
    }
    true
}

fn operations() -> bool {
    let b = buffer().unwrap();
    b.append(octets("one two three\nalpha\nbeta").unwrap()).unwrap();
    b.saved();
    let mut v = view();
    let mut vi = controls();
    keys(&b, &mut v, &mut vi, "d2w");
    if (!equal(&b, "three\nalpha\nbeta")) {
        println("d2w failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u2dd");
    if (!equal(&b, "beta")) {
        println("2dd failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "uGdd");
    if (!equal(&b, "one two three\nalpha")) {
        println("last dd failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u0viwdiOK" + from_char(27 as char) + "");
    if (!equal(&b, "one two three\nalpha\nOK")) {
        println("visual iw failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u");
    if (!equal(&b, "one two three\nalpha\n")) {
        println("insert group failed");
        return false;
    }
    true
}

fn indentation() -> bool {
    let b = buffer().unwrap();
    b.append(octets("  foo\r\nbar\r\n").unwrap()).unwrap();
    b.saved();
    let mut v = view();
    let mut vi = controls();
    keys(&b, &mut v, &mut vi, "A!\nnext" + from_char(27 as char) + "");
    if (!equal(&b, "  foo!\r\n  next\r\nbar\r\n")) {
        println("CRLF indent failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u>>");
    if (!equal(&b, "      foo\r\nbar\r\n")) {
        println("indent failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "uOabove" + from_char(27 as char) + "");
    if (!equal(&b, "  above\r\n  foo\r\nbar\r\n")) {
        println("O failed");
        return false;
    }
    true
}

fn lexing() -> bool {
    let b = buffer().unwrap();
    b.append(octets("/* hello\nworld */ let x = 42;\n").unwrap()).unwrap();
    b.language(1);
    let styles: Vec<u32> = [0, 256, 512, 768, 1024, 1280, 1536];
    let cells = b.cells(1, 0, 32, 4, styles, 4096, 0, 0).unwrap();
    if (cells[0] != (256 | 119) || cells[9] != (512 | 108)) {
        return false;
    }
    b.begin(0);
    b.replace(0, 2, octets("//").unwrap()).unwrap();
    b.end(0);
    let cells = b.cells(1, 0, 32, 4, styles, 4096, 0, 0).unwrap();
    if (cells[0] != (0 | 119)) {
        return false;
    }
    true
}

fn digit_and_paste() -> bool {
    let b = buffer().unwrap();
    b.append(octets("abc1def\nlast").unwrap()).unwrap();
    b.saved();
    let mut v = view();
    let mut vi = controls();
    keys(&b, &mut v, &mut vi, "f1r2");
    if (!equal(&b, "abc2def\nlast")) {
        println("digit target failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "uyyGp");
    if (!equal(&b, "abc1def\nlast\nabc1def\n")) {
        println("line paste failed");
        return false;
    }
    if (v.cursor != 13) {
        println("paste cursor failed");
        return false;
    }
    true
}

fn unicode_editing() -> bool {
    let b = buffer().unwrap();
    let mut v = view();
    let mut vi = controls();
    let s = settings();
    keys(&b, &mut v, &mut vi, "i");
    for (scalar in [1046 as u32, 101, 769, 20013, 128578, 258]) {
        event(&b, &mut v, &mut vi, InputEvent { kind: 0, value: scalar, mouse: None }, &s, 19);
    }
    if (!equal(&b, "Жé中🙂Ă") || v.cursor != b.len() || b.visual(v.cursor, 4) != 7) {
        println("Unicode input or key collision failed");
        return false;
    }
    key(&b, &mut v, &mut vi, 263, &s, 19);
    key(&b, &mut v, &mut vi, 260, &s, 19);
    key(&b, &mut v, &mut vi, 263, &s, 19);
    keys(&b, &mut v, &mut vi, from_char(27 as char) + "lx");
    if (!equal(&b, "Жé") || v.cursor != 2) {
        println("Grapheme deletion failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "u.");
    if (!equal(&b, "Жé")) {
        println("Unicode undo/dot failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "0v");
    let bounds = selection(&b, v, &vi);
    if (bounds.start != 0 || bounds.end != 2) {
        println("Unicode selection failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "y$p");
    if (!equal(&b, "ЖéЖ")) {
        println("Unicode register/paste failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "r");
    event(&b, &mut v, &mut vi, InputEvent { kind: 0, value: 20013, mouse: None }, &s, 19);
    keys(&b, &mut v, &mut vi, "0.");
    if (!equal(&b, "中é中")) {
        println("Unicode replacement/dot failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "f");
    event(&b, &mut v, &mut vi, InputEvent { kind: 0, value: 20013, mouse: None }, &s, 19);
    if (v.cursor != 6) {
        println("Unicode character search failed");
        return false;
    }
    keys(&b, &mut v, &mut vi, "F");
    event(&b, &mut v, &mut vi, InputEvent { kind: 0, value: 20013, mouse: None }, &s, 19);
    if (v.cursor != 0) {
        println("Unicode backward search failed");
        return false;
    }
    // A full emoji ZWJ sequence is one selectable/deletable unit.
    let emoji = buffer().unwrap();
    emoji.append(octets("A👩‍💻Z\r\n").unwrap()).unwrap();
    let mut ev = view();
    let mut ec = controls();
    keys(&emoji, &mut ev, &mut ec, "lv");
    let selected = selection(&emoji, ev, &ec);
    if (selected.start != 1 || selected.end != 12) {
        println("Emoji cluster selection failed");
        return false;
    }
    keys(&emoji, &mut ev, &mut ec, "d");
    if (!equal(&emoji, "AZ\r\n")) {
        println("Emoji cluster deletion failed");
        return false;
    }
    keys(&emoji, &mut ev, &mut ec, "u");
    if (!equal(&emoji, "A👩‍💻Z\r\n")) {
        return false;
    }
    true
}

fn typing_format() -> bool {
    let b = buffer().unwrap();
    let mut v = view();
    let mut vi = controls();
    let mut s = settings();
    s.textwidth = 20;
    let input = "ione two three four five six seven eight nine";
    for (i in 0..input.len()) {
        key(&b, &mut v, &mut vi, input[i] as i16, &s, 19);
    }
    key(&b, &mut v, &mut vi, 27, &s, 19);
    if (!equal(&b, "one two three four\nfive six seven eight\nnine")) {
        println("Typed prose formatting failed");
        return false;
    }
    key(&b, &mut v, &mut vi, 117, &s, 19);
    if (!equal(&b, "")) {
        println("Formatting undo grouping failed");
        return false;
    }
    s.format_text = false;
    for (i in 0..input.len()) {
        key(&b, &mut v, &mut vi, input[i] as i16, &s, 19);
    }
    key(&b, &mut v, &mut vi, 27, &s, 19);
    if (!equal(&b, "one two three four five six seven eight nine")) {
        println("Typing formatting disable failed");
        return false;
    }
    true
}

fn main() -> i16 {
    if (!typing_format()) {
        return 9;
    }
    if (!object_change()) {
        return 1;
    }
    if (!operations()) {
        return 2;
    }
    if (!indentation()) {
        return 3;
    }
    if (!digit_and_paste()) {
        return 7;
    }
    if (!lexing()) {
        return 4;
    }
    if (!unicode_editing()) {
        return 8;
    }
    if (detect("Makefile").name != "make" || detect("HELLO.BF").lexer != 8 as u16 || detect("main.rfl").lexer != 1 as u16) {
        return 5;
    }
    let syma = detect("DEMO.SYMA");
    if (syma.name != "syma" || syma.lexer != 15 as u16 || syma.tool != "syma" || syma.variable != "SYMA" || syma.arguments != "run {file}" || detect("demo.symnb").lexer != 5 as u16) {
        return 12;
    }
    let worksheet = detect("OBJECTS.SYMWS");
    if (worksheet.name != "syma" || worksheet.lexer != 15 as u16 || worksheet.arguments != "worksheet {file} --run") {
        return 13;
    }
    for (file in ["hello.js", "module.mjs", "SCRIPT.CJS"]) {
        let js = detect(file);
        if (js.name != "javascript" || js.lexer != 14 as u16 || js.tool != "js" || js.variable != "JS") {
            return 10;
        }
    }
    if (detect("hello.server.mjs").arguments != "--server {file}" || detect("hello.server.js").arguments != "--server {file}" || detect("hello.mjs").arguments != "{file}") {
        return 11;
    }
    if (joined("/a/b", "../x") != "/a/x" || parent("/a") != "/" || basename("/a/b") != "b") {
        return 6;
    }
    println("RIFT_CORE_OK");
    0
}
